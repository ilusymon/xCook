/* 星厨房 全局样式 — 温馨情侣主题 */

page {
  --color-primary: #EF8297;
  --color-primary-light: #F6AEBB;
  --color-primary-dark: #D96D82;
  --color-secondary: #E8B453;
  --color-bg: #FFF5D9;
  --color-bg-card: #FFFDF7;
  --color-text: #493B37;
  --color-text-secondary: #816F69;
  --color-success: #5FD068;
  --color-warning: #FF9F43;
  --color-border: #F1DDD2;

  /* iView Weapp 主题覆盖 */
  --button-primary-bg-color: #EF8297;
  --button-primary-active-color: #D96D82;
  --tab-bar-active-color: #EF8297;
  --tag-primary-color: #EF8297;
  --switch-checked-color: #EF8297;

  background-color: #FFF5D9;
  color: #493B37;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

/* 通用卡片 */
.card {
  background: #FFFDF7;
  border-radius: 24rpx;
  border: 2rpx solid rgba(73, 59, 55, 0.05);
  box-shadow: 0 6rpx 18rpx rgba(111, 82, 55, 0.09);
  padding: 24rpx;
  margin: 16rpx 24rpx;
}

/* 主按钮 */
.btn-primary {
  background: #EF8297;
  color: #FFFFFF;
  border: none;
  border-radius: 40rpx;
  padding: 20rpx 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(239, 130, 151, 0.28);
}

.btn-primary:active {
  background: #D96D82;
  transform: scale(0.98);
}

/* 次要按钮 */
.btn-secondary {
  background: #FFFDF7;
  color: #EF8297;
  border: 2rpx solid #EF8297;
  border-radius: 40rpx;
  padding: 18rpx 48rpx;
  font-size: 28rpx;
  text-align: center;
}

/* 标签 */
.tag {
  display: inline-block;
  border-radius: 16rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  line-height: 1.6;
}

.tag-calorie {
  background: #FFF0E6;
  color: #FF9F43;
}

.tag-coin {
  background: #FFF8E6;
  color: #FFC048;
}

.tag-difficulty {
  background: #FCE6EA;
  color: #D96D82;
}

/* 星星币显示 */
.star-coin {
  display: inline-flex;
  align-items: center;
  color: #FFC048;
  font-weight: 600;
}

.star-coin-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 6rpx;
}

/* 价格文字 */
.price {
  font-size: 32rpx;
  font-weight: bold;
  color: #FFC048;
}

/* 区域标题 */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #493B37;
  margin: 24rpx 0 16rpx 0;
}

/* 辅助文字 */
.text-secondary {
  font-size: 24rpx;
  color: #816F69;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: #F1DDD2;
  margin: 16rpx 0;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.empty-state-image {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-state-text {
  font-size: 28rpx;
  color: #816F69;
}

/* 页面容器 */
.page-container {
  min-height: 100vh;
  background: #FFF5D9;
  padding-bottom: 120rpx;
}

/* 输入框 */
.input-box {
  border: 2rpx solid #F1DDD2;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  background: #FFFDF7;
}

.input-box:focus {
  border-color: #EF8297;
}

/* 浮动操作按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 160rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #EF8297;
  box-shadow: 0 8rpx 24rpx rgba(239, 130, 151, 0.34);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 48rpx;
  z-index: 100;
}

/* 弹跳动画 */
@keyframes bounce {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.2); }
}

.bounce {
  animation: bounce 0.3s ease;
}

/* 淡入动画 */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.fade-in {
  animation: fadeIn 0.3s ease;
}
