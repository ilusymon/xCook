.dish-card {
  display: flex;
  width: 100%;
  box-sizing: border-box;
  background: var(--color-bg-card, #FFFCF3);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 129, 0.08);
  margin-bottom: 20rpx;
  overflow: hidden;
  padding: 20rpx;
}

.dish-cover-wrap {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  overflow: hidden;
  background: var(--color-bg, #FFF9EA);
}

.dish-cover-loading {
  display: flex; align-items: center; justify-content: center; color: #8A7466; font-size: 24rpx;
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.dish-cover {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  transition: opacity 0.3s;
}

.dish-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.dish-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dish-name {
  font-family: 'XCookHand', 'YouYuan', sans-serif;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text, #593B30);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

.calorie-tag {
  background: #FFF0E6;
  color: var(--color-secondary, #916A34);
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.dish-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary, #8A7466);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin: 8rpx 0;
}

.dish-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dish-time {
  display: flex;
  align-items: center;
}

.time-text {
  font-size: 22rpx;
  color: var(--color-text-secondary, #8A7466);
}

.add-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary, #FF9278), #FFB79C);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 129, 0.3);
}

.add-btn:active {
  transform: scale(0.9);
}
