@import '../../styles/button-reset.wxss';
.home-btn {
  width: 80rpx;
  min-height: 80rpx;
  padding: 10rpx;
  margin: 0 16rpx 0 0;
  box-sizing: border-box;
  border-radius: 50%;
  background: var(--color-bg, #FFF9EA);
  border: 2rpx solid var(--color-border, #B89A80);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.home-btn:active {
  background: var(--color-border, #B89A80);
}

.home-icon {
  width: 56rpx;
  height: 56rpx;
}
.home-btn::after { border: 0; }
