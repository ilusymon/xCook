.material-list {
  padding: 26rpx;
  background: #FFFCF3;
  border: 2rpx solid #593B30;
  border-radius: 30rpx;
  box-shadow: 3rpx 5rpx 0 #EEDBC0;
}

.material-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.material-title {
  font-family: 'XCookHand', 'YouYuan', sans-serif;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text, #593B30);
}

.material-count {
  font-size: 24rpx;
  color: #8B8581;
}

.material-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F0E5DF;
  transition: opacity 0.2s ease;
}

.material-item:last-child {
  border-bottom: none;
}

.material-item.checked {
  opacity: 0.5;
}

.material-item.checked .material-name {
  text-decoration: line-through;
}

.check-box {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #B89A80;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.check-inner {
  color: var(--color-primary-dark, #9F4F38);
  font-size: 24rpx;
  font-weight: bold;
}

.material-item.checked .check-box {
  background: var(--color-primary, #FF9278);
  border-color: #593B30;
}

.material-item.checked .check-inner {
  color: #593B30;
}

.material-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text, #593B30);
}

.material-amount {
  font-size: 26rpx;
  color: var(--color-secondary, #916A34);
  font-weight: 500;
  margin: 0 16rpx;
}

.material-note {
  font-size: 22rpx;
  color: #8B8581;
}
