.step-card {
  display: flex;
  padding: 16rpx 0;
  transition: all 0.3s ease;
}

.step-indicator {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.step-number {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #FFE4D8;
  color: var(--color-primary-dark, #9F4F38);
  font-size: 26rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-card.active .step-number {
  background: var(--color-primary, #FF9278);
  color: #593B30;
  box-shadow: 0 4rpx 14rpx rgba(255, 105, 119, 0.24);
}

.step-check {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #91AB73;
  color: #593B30;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-line {
  width: 4rpx;
  flex: 1;
  min-height: 40rpx;
  background: #F3D9DE;
  margin: 8rpx 0;
}

.step-card.completed .step-line {
  background: #91AB73;
}

.step-content {
  flex: 1;
  padding: 22rpx;
  background: #FFFCF3;
  border: 2rpx solid #593B30;
  border-radius: 26rpx;
  box-shadow: 3rpx 5rpx 0 #EEDBC0;
}

.step-card.active .step-content {
  border: 2rpx solid #B89A80;
  box-shadow: 0 5rpx 16rpx rgba(239, 102, 126, 0.12);
}

.step-desc {
  font-size: 28rpx;
  color: var(--color-text, #593B30);
  line-height: 1.6;
}

.step-image-wrap {
  position: relative;
  width: 100%;
  height: 300rpx;
  border-radius: 16rpx;
  margin-top: 16rpx;
  overflow: hidden;
  background: #FFF4D8;
}

.step-image-loading {
  display: flex; align-items: center; justify-content: center; color: #8A7466; font-size: 24rpx;
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.step-image {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  transition: opacity 0.3s;
}

.step-meta {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.step-duration {
  font-size: 24rpx;
  color: #8B8581;
}
