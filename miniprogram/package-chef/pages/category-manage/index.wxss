.category-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 36rpx calc(184rpx + env(safe-area-inset-bottom));
  color: var(--color-text, #593B30);
  background-color: var(--color-bg, #FFF9EA);
}

.top-bar {
  min-height: 84rpx;
  margin-bottom: 18rpx;
  display: flex;
  align-items: center;
}

.page-title {
  font-family: 'XCookHand', 'YouYuan', sans-serif;
  flex: 1;
  color: #593B30;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-align: center;
  transform: translateX(-44rpx);
}

.category-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.category-item {
  padding: 22rpx;
  background: #FFFCF3;
  border: 2rpx solid #593B30;
  border-radius: 30rpx;
  box-shadow: 3rpx 5rpx 0 #EEDBC0;
  transition: border-color 0.18s ease, transform 0.18s ease;
}

.category-item.editing {
  border-color: #EFA2AF;
  box-shadow: 0 5rpx 16rpx rgba(239, 102, 126, 0.12);
}

.item-row {
  min-height: 76rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.item-emoji {
  flex: none;
  width: 60rpx;
  height: 60rpx;
  margin-right: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF4D8;
  border-radius: 18rpx;
  font-size: 36rpx;
}

.item-name {
  font-family: 'XCookHand', 'YouYuan', sans-serif;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #201613;
  font-size: 27rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-name.disabled {
  color: #AFA7A2;
  text-decoration: line-through;
}

.item-actions {
  flex: 0 0 calc(100% - 74rpx);
  margin: 16rpx 0 0 74rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.sort-btns {
  display: flex;
  gap: 4rpx;
}

.sort-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-secondary, #8A7466);
  background: #F7F3F1;
  border: 1rpx solid #DED4CF;
  border-radius: 16rpx;
  font-size: 24rpx;
}

.sort-btn.sort-disabled {
  opacity: 0.28;
}

.active-switch {
  margin: 0 -10rpx;
  transform: scale(0.72);
}

.action-btn {
  min-width: 92rpx;
  min-height: 72rpx;
  padding: 0 16rpx;
  justify-content: center;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  border: 1rpx solid transparent;
  border-radius: 26rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.action-btn.edit {
  color: var(--color-primary-dark, #9F4F38);
  background: #FFE4D8;
  border-color: #F4CFD5;
}

.action-btn.delete {
  color: #8B817C;
  background: #F7F3F1;
  border-color: #DED4CF;
}

.edit-panel {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.edit-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.edit-emoji {
  display: none;
}

.edit-emoji-display {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: #FFF4D8;
  border: 1rpx solid #EAD7B2;
  border-radius: 22rpx;
  font-size: 40rpx;
}

.edit-input {
  flex: 1;
  min-height: 76rpx;
  box-sizing: border-box;
  padding: 16rpx 20rpx;
  color: var(--color-text, #593B30);
  background: var(--color-bg-card, #FFFCF3);
  border: 1rpx solid #E6D9D2;
  border-radius: 22rpx;
  font-size: 27rpx;
}

.icon-picker {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 16rpx;
  background: #FFF9EA;
  border: 1rpx solid #D6EAF3;
  border-radius: 24rpx;
}

.icon-option {
  min-width: 104rpx;
  min-height: 92rpx;
  padding: 10rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid transparent;
  border-radius: 20rpx;
}

.icon-option.active {
  background: #FFE4D8;
  border-color: #EFA2AF;
}

.icon-option-emoji {
  margin-bottom: 4rpx;
  font-size: 36rpx;
}

.icon-option-label {
  color: var(--color-text-secondary, #8A7466);
  font-size: 19rpx;
}

.edit-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
}

.edit-btn {
  min-width: 126rpx;
  min-height: 68rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid;
  border-radius: 34rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.edit-btn.cancel {
  color: var(--color-text-secondary, #8A7466);
  background: var(--color-bg-card, #FFFCF3);
  border-color: #D8C6BD;
}

.edit-btn.save {
  color: #593B30;
  background: var(--color-primary, #FF9278);
  border-color: #593B30;
}

.empty-state {
  padding: 120rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #7C8588;
}

.empty-emoji {
  margin-bottom: 18rpx;
  font-size: 86rpx;
}

.empty-text {
  font-size: 24rpx;
}

.add-btn {
  position: fixed;
  z-index: 10;
  left: 50%;
  bottom: calc(42rpx + env(safe-area-inset-bottom));
  min-width: 330rpx;
  min-height: 88rpx;
  padding: 0 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-sizing: border-box;
  color: #593B30;
  background: var(--color-primary, #FF9278);
  border: 2rpx solid #593B30;
  border-radius: 44rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 105, 119, 0.22);
  font-weight: 600;
  transform: translateX(-50%);
}

.add-icon {
  font-size: 34rpx;
  font-weight: 700;
}

.add-text {
  font-size: 26rpx;
}

.add-btn { margin: 0; line-height: 86rpx; }
.sort-btn, .action-btn, .edit-btn { min-height: 88rpx; }
.item-actions { flex: 0 0 100%; margin-left: 0; flex-wrap: wrap; }
