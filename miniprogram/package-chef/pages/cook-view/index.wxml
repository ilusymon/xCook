<view class="cook-page {{wishlistMode ? 'wishlist-mode' : ''}}">
  <view class="state-panel" wx:if="{{loading}}">菜谱加载中...</view>
  <view class="state-panel" wx:elif="{{error}}"><text>{{error}}</text><button class="btn-secondary" bindtap="loadDish">重新加载菜谱</button></view>
  <view class="state-panel" wx:if="{{progressError}}"><text>{{progressError}}</text><button class="btn-secondary" bindtap="startWatch">重新加载进度</button></view>
  <!-- 菜品头部 -->
  <view class="dish-header">
    <view class="dish-cover"><dish-art cover-image="{{dish.coverImage}}" dish-name="{{dish.name}}" /></view>
    <view class="dish-overlay">
      <text class="dish-name">{{dish.name}}</text>
      <view class="dish-tags">
        <text class="dish-tag" wx:if="{{wishlistMode}}">{{itemStatus === 'accepted' ? '等待制作' : itemStatus === 'done' ? '已完成' : wishlistStatus === 'cancelled' ? '已取消' : '制作中'}} · {{wishlistItem.quantity}} 份</text>
        <text class="dish-tag" wx:if="{{!wishlistMode}}">{{dish.calories}}kcal</text>
        <text class="dish-tag" wx:if="{{!wishlistMode && dish.preparationTime}}">{{dish.preparationTime}}分钟</text>
      </view>
    </view>
  </view>

  <!-- 食材清单 -->
  <view class="section" wx:if="{{dish.materials.length}}">
    <material-list
      id="materialList"
      materials="{{dish.materials}}"
      interactive="{{true}}"
    />
  </view>

  <!-- 制作步骤 -->
  <view class="section">
    <view class="section-title-bar">
      <text class="section-title">制作步骤</text>
      <text class="step-progress" wx:if="{{dish.steps.length}}">{{currentStep + 1}} / {{dish.steps.length}}</text>
    </view>

    <view class="steps-timeline">
      <view class="state-panel" wx:if="{{!loading && !dish.steps.length}}">这道菜没有配置步骤，可直接开始并确认完成。</view>
      <step-card
        wx:for="{{dish.steps}}"
        wx:key="stepNumber"
        step="{{item}}"
        isActive="{{currentStep === index}}"
        isCompleted="{{index < currentStep}}"
        isLast="{{index === dish.steps.length - 1}}"
        bindtap="goToStep"
        data-index="{{index}}"
      />
    </view>
  </view>

  <!-- 底部导航 -->
  <view class="bottom-nav">
    <button class="nav-btn prev" disabled="{{wishlistMode || currentStep <= 0}}" bindtap="prevStep">
      ‹ 上一步
    </button>
    <button class="nav-btn video" wx:if="{{dish.videoUrl}}" bindtap="playVideo">
      ▶ 看视频
    </button>
    <button class="nav-btn next {{itemStatus === 'done' || (!wishlistMode && currentStep >= dish.steps.length - 1) ? 'done' : ''}}" bindtap="nextStep" disabled="{{busy || loading || error || progressError || (wishlistMode && itemStatus !== 'accepted' && itemStatus !== 'cooking')}}" loading="{{busy}}">
      {{wishlistMode ? nextLabel : currentStep >= dish.steps.length - 1 ? '完成 ✓' : '下一步 ›'}}
    </button>
  </view>
</view>
