.cook-page { min-height: 100vh; padding: 24rpx 28rpx calc(180rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: var(--color-bg); }
.dish-header { display: flex; align-items: center; gap: 24rpx; min-height: 184rpx; margin-bottom: 28rpx; padding: 18rpx; border: 2rpx solid var(--color-text); border-radius: 28rpx; background: var(--color-bg-card); box-shadow: 4rpx 6rpx 0 #EEDBC0; }
.dish-cover { flex-shrink: 0; width: 150rpx; height: 150rpx; overflow: hidden; border-radius: 20rpx; }
.dish-overlay { flex: 1; min-width: 0; }
.dish-name {
  font-family: 'XCookHand', 'YouYuan', sans-serif; display: block; font-family: 'XCookHand', 'YouYuan', sans-serif; font-size: 38rpx; line-height: 1.4; }
.dish-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }
.dish-tag { padding: 6rpx 14rpx; border-radius: 18rpx; background: #FFE0D1; font-size: 22rpx; }
.section { margin-bottom: 28rpx; }
.section-title-bar { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; margin-bottom: 14rpx; }
.section-title { margin: 0; }
.step-progress { padding: 8rpx 20rpx; border: 2rpx solid var(--color-text); border-radius: 20rpx; background: #FFE293; font-size: 24rpx; }
.bottom-nav { position: fixed; z-index: 10; bottom: 0; left: 0; right: 0; display: flex; gap: 16rpx; align-items: center; padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); border-top: 2rpx solid var(--color-text); border-radius: 28rpx 28rpx 0 0; background: var(--color-bg); }
.nav-btn { flex: 1; min-width: 0; min-height: 88rpx; margin: 0; padding: 0 16rpx; border: 2rpx solid var(--color-text); border-radius: 44rpx; font-size: 26rpx; line-height: 84rpx; background: var(--color-bg-card); box-shadow: 0 4rpx 0 #E4C5A8; }
.nav-btn.video { background: #BDDCED; }
.nav-btn.next { background: var(--color-primary); }
.nav-btn.next.done { background: #DDEAC4; }
