.edit-page {
  min-height: 100vh;
  background: var(--color-bg, #FFF9EA);
  padding: 16rpx 24rpx;
  padding-bottom: 160rpx;
}

.section-card {
  background: var(--color-bg-card, #FFFCF3);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(255, 107, 129, 0.06);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text, #593B30);
  margin-bottom: 20rpx;
  display: block;
}

.section-header .section-title {
  margin-bottom: 0;
}

.add-btn {
  font-size: 24rpx;
  color: var(--color-primary, #FF9278);
  padding: 8rpx 20rpx;
  background: var(--color-border, #B89A80);
  border-radius: 20rpx;
}

/* 封面图上传 */
.cover-upload {
  width: 100%;
  height: 320rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: var(--color-bg, #FFF9EA);
  border: 2rpx dashed #FFB8C6;
}

.cover-preview {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.upload-text {
  font-size: 24rpx;
  color: var(--color-text-secondary, #8A7466);
}

/* 表单 */
.form-item {
  margin-bottom: 20rpx;
}

.form-label {
  font-size: 26rpx;
  color: var(--color-text-secondary, #8A7466);
  margin-bottom: 8rpx;
  display: block;
}

.form-input {
  border: 2rpx solid var(--color-border, #B89A80);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  background: #FEFEFE;
}

.form-textarea {
  border: 2rpx solid var(--color-border, #B89A80);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  width: 100%;
  height: 120rpx;
  box-sizing: border-box;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-item.half {
  flex: 1;
}

.picker-display {
  color: var(--color-text, #593B30);
}

/* 难度选择 */
.difficulty-picker {
  display: flex;
  gap: 12rpx;
}

.diff-option {
  flex: 1;
  text-align: center;
  padding: 12rpx;
  font-size: 24rpx;
  border: 2rpx solid var(--color-border, #B89A80);
  border-radius: 14rpx;
  color: var(--color-text-secondary, #8A7466);
  transition: all 0.2s ease;
}

.diff-option.active {
  background: var(--color-primary, #FF9278);
  border-color: var(--color-primary, #FF9278);
  color: #593B30;
}

/* ====== 树形选项组 ====== */

.tree-empty {
  padding: 32rpx 16rpx;
  text-align: center;
}

.tree-empty-text {
  font-size: 24rpx;
  color: #B0B0B0;
}

/* 每个选项组 */
.tree-group {
  margin-bottom: 24rpx;
}

/* 父节点（选项组名称行） */
.tree-parent {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #FFF9F9;
  border: 2rpx solid var(--color-border, #B89A80);
  border-radius: 18rpx;
  padding: 16rpx 20rpx;
}

.tree-parent-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.tree-arrow {
  font-size: 32rpx;
  color: #FFB8C6;
  font-weight: bold;
  margin-right: 8rpx;
  transition: transform 0.2s ease;
  width: 28rpx;
  text-align: center;
  flex-shrink: 0;
}

.tree-arrow.down {
  transform: rotate(90deg);
}

.tree-parent-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.tree-parent-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text, #593B30);
  border: none;
  min-width: 0;
}

.tree-parent-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.tree-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 14rpx;
  font-weight: 500;
}

.tree-tag.tag-single {
  background: #E8F0FF;
  color: #54A0FF;
}

.tree-tag.tag-multi {
  background: #E8F8E8;
  color: #91AB73;
}

.tree-tag.tag-required {
  background: var(--color-border, #B89A80);
  color: var(--color-primary, #FF9278);
}

.tree-tag.tag-optional {
  background: #F5F0F0;
  color: var(--color-text-secondary, #8A7466);
}

.tree-del {
  font-size: 24rpx;
  color: #C0B0B0;
  padding: 4rpx 8rpx;
  margin-left: 4rpx;
}

/* 子节点容器 */
.tree-children {
  position: relative;
  padding-left: 34rpx;
  margin-top: 4rpx;
}

/* 竖线（贯穿所有子节点） */
.tree-branch-line {
  position: absolute;
  left: 34rpx;
  top: 0;
  bottom: 48rpx;
  width: 3rpx;
  background: #FFD6DC;
}

/* 每个子节点 */
.tree-child {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  position: relative;
}

/* 连接线（竖线+横线） */
.tree-connector {
  position: relative;
  width: 28rpx;
  height: 100%;
  flex-shrink: 0;
}

.tree-vert-line {
  position: absolute;
  left: 0;
  top: -10rpx;
  bottom: -10rpx;
  width: 3rpx;
  background: #FFD6DC;
}

.tree-vert-line.last {
  bottom: 50%;
}

.tree-horiz-line {
  position: absolute;
  left: 0;
  top: 50%;
  width: 100%;
  height: 3rpx;
  background: #FFD6DC;
}

/* 子节点圆点 */
.tree-child-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--color-primary, #FF9278);
  flex-shrink: 0;
  margin-right: 12rpx;
  box-shadow: 0 0 0 4rpx var(--color-border, #B89A80);
}

/* 子节点内容 */
.tree-child-body {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--color-bg-card, #FFFCF3);
  border: 1rpx solid var(--color-border, #B89A80);
  border-radius: 14rpx;
  padding: 12rpx 16rpx;
  gap: 12rpx;
  min-width: 0;
}

.tree-child-name {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text, #593B30);
  border: none;
  min-width: 0;
}

.tree-child-del {
  font-size: 22rpx;
  color: #C0B0B0;
  padding: 8rpx;
  margin-left: 4rpx;
  flex-shrink: 0;
}

/* 添加子选项行 */
.tree-add-child {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  position: relative;
}

.tree-add-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx dashed #FFB8C6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--color-primary, #FF9278);
  flex-shrink: 0;
  margin-right: 12rpx;
}

.tree-add-text {
  font-size: 24rpx;
  color: var(--color-primary, #FF9278);
}

/* 材料编辑 */
.material-edit-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.mat-name-input {
  flex: 2;
  border: 1rpx solid var(--color-border, #B89A80);
  border-radius: 12rpx;
  padding: 10rpx 14rpx;
  font-size: 26rpx;
}

.mat-amount-input {
  flex: 1;
  border: 1rpx solid var(--color-border, #B89A80);
  border-radius: 12rpx;
  padding: 10rpx 14rpx;
  font-size: 26rpx;
}

.mat-note-input {
  flex: 1;
  border: 1rpx solid var(--color-border, #B89A80);
  border-radius: 12rpx;
  padding: 10rpx 14rpx;
  font-size: 26rpx;
}

.remove-mat {
  font-size: 22rpx;
  color: #B0B0B0;
  padding: 4rpx 8rpx;
}

/* 步骤编辑 */
.step-edit-item {
  display: flex;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--color-border, #B89A80);
}

.step-edit-item:last-child {
  border-bottom: none;
}

.step-number-badge {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--color-border, #B89A80);
  color: var(--color-primary, #FF9278);
  font-size: 24rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.step-edit-content {
  flex: 1;
}

.step-desc-input {
  width: 100%;
  border: 1rpx solid var(--color-border, #B89A80);
  border-radius: 12rpx;
  padding: 12rpx 14rpx;
  font-size: 26rpx;
  height: 100rpx;
  box-sizing: border-box;
}

.step-meta-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
}

.step-duration-input {
  width: 140rpx;
  border: 1rpx solid var(--color-border, #B89A80);
  border-radius: 12rpx;
  padding: 8rpx 14rpx;
  font-size: 24rpx;
}

.step-img-btn {
  font-size: 24rpx;
  color: #54A0FF;
  padding: 8rpx 16rpx;
  background: #E8F0FF;
  border-radius: 12rpx;
}

.step-preview {
  width: 200rpx;
  height: 150rpx;
  border-radius: 12rpx;
  margin-top: 12rpx;
}

.step-actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-left: 12rpx;
}

.move-btn {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  background: var(--color-bg, #FFF9EA);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--color-text-secondary, #8A7466);
}

.remove-step {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #B0B0B0;
}

/* 保存按钮 */
.save-btn-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx 40rpx;
  background: var(--color-bg, #FFF9EA);
}

.save-btn { width: 100%; box-sizing: border-box;
  background: linear-gradient(135deg, var(--color-primary, #FF9278), #FFB79C);
  color: #593B30;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  padding: 24rpx;
  border-radius: 44rpx;
  box-shadow: 0 6rpx 24rpx rgba(255, 107, 129, 0.3);
}

/* 与吃货端统一的蓝白格纹纸张主题 */
.edit-page {
  padding: 24rpx 36rpx calc(190rpx + env(safe-area-inset-bottom));
  color: var(--color-text, #593B30);
  background-color: var(--color-bg, #FFF9EA);
}

.section-card {
  margin-bottom: 18rpx;
  padding: 26rpx;
  background: #FFFCF3;
  border: 2rpx solid #593B30;
  border-radius: 30rpx;
  box-shadow: 3rpx 5rpx 0 #EEDBC0;
}

.section-title,
.picker-display,
.tree-parent-name,
.tree-child-name {
  color: var(--color-text, #593B30);
}

.section-title {
  font-size: 29rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.add-btn,
.tree-add-text {
  color: var(--color-primary-dark, #9F4F38);
  background: #FFE4D8;
  border: 1rpx solid #D7B49C;
}

.add-btn {
  min-height: 56rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  border-radius: 28rpx;
  font-weight: 600;
}

.cover-upload {
  height: 330rpx;
  background: #FFF4D8;
  border-color: #D8C6BD;
  border-radius: 24rpx;
}

.upload-text,
.form-label,
.tree-empty-text,
.tree-tag.tag-optional,
.remove-mat,
.remove-step {
  color: #8B8581;
}

.form-input,
.form-textarea,
.mat-name-input,
.mat-amount-input,
.mat-note-input,
.step-desc-input,
.step-duration-input {
  min-height: 72rpx;
  box-sizing: border-box;
  color: var(--color-text, #593B30);
  background: var(--color-bg-card, #FFFCF3);
  border-color: #E6D9D2;
  border-radius: 20rpx;
}

.form-textarea,
.step-desc-input {
  min-height: 128rpx;
}

.diff-option {
  min-height: 70rpx;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-secondary, #8A7466);
  background: var(--color-bg-card, #FFFCF3);
  border-color: #D8C6BD;
  border-radius: 35rpx;
}

.diff-option.active {
  color: #593B30;
  background: var(--color-primary, #FF9278);
  border-color: #593B30;
}

.tree-parent {
  background: #FFF9EA;
  border-color: #D6EAF3;
  border-radius: 22rpx;
}

.tree-arrow {
  color: #75B8D2;
}

.tree-child-dot,
.step-number-badge {
  color: var(--color-primary-dark, #9F4F38);
  background: #FFE4D8;
  box-shadow: 0 0 0 4rpx #F9DCE1;
}

.tree-branch-line,
.tree-vert-line,
.tree-horiz-line {
  background: #CDE7F1;
}

.tree-child-body {
  background: var(--color-bg-card, #FFFCF3);
  border-color: #E6D9D2;
  border-radius: 18rpx;
}

.tree-add-dot {
  color: var(--color-primary-dark, #9F4F38);
  border-color: #B89A80;
}

.step-edit-item {
  border-color: #F0E5DF;
}

.step-img-btn {
  min-height: 56rpx;
  display: flex;
  align-items: center;
  color: #356D86;
  background: #EDF8FD;
  border: 1rpx solid #C8E5F1;
  border-radius: 28rpx;
}

.move-btn {
  width: 52rpx;
  height: 52rpx;
  color: var(--color-text-secondary, #8A7466);
  background: #F7F3F1;
  border: 1rpx solid #DED4CF;
  border-radius: 16rpx;
}

.save-btn-wrap {
  padding: 18rpx 36rpx calc(28rpx + env(safe-area-inset-bottom));
  background: #FFF9EA;
  border-top: 1rpx solid rgba(113, 88, 74, 0.08);
}

.save-btn {
  min-height: 88rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary, #FF9278);
  border: 2rpx solid #593B30;
  border-radius: 44rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 105, 119, 0.22);
  font-size: 28rpx;
}

.save-btn { margin: 0; line-height: 86rpx; }
.material-edit-item { flex-wrap: wrap; gap: 8rpx; }
.tree-parent { flex-wrap: wrap; gap: 12rpx; }
.tree-parent-left { min-width: 240rpx; }
.tree-parent-right { margin-left: auto; }
.mat-name-input, .mat-amount-input { min-width: 140rpx; }
