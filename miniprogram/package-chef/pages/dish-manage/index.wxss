.manage-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 36rpx 190rpx;
  color: var(--color-text, #593B30);
  background-color: var(--color-bg, #FFF9EA);
}

.category-group {
  margin-bottom: 28rpx;
}

.category-name {
  font-family: 'XCookHand', 'YouYuan', sans-serif;
  display: block;
  padding: 12rpx 8rpx 14rpx;
  color: var(--color-text, #593B30);
  font-size: 27rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.dish-item {
  position: relative;
  display: flex;
  min-height: 256rpx;
  box-sizing: border-box;
  margin-bottom: 14rpx;
  padding: 16rpx 18rpx;
  background: #FFFCF3;
  border: 2rpx solid #593B30;
  border-radius: 30rpx;
  box-shadow: 3rpx 5rpx 0 #EEDBC0;
}

.dish-cover { overflow: hidden;
  flex: 0 0 144rpx;
  width: 144rpx;
  height: 144rpx;
  background: #FFF4D8;
  border-radius: 20rpx;
}

.dish-info {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  padding-top: 18rpx;
}

.dish-name {
  font-family: 'XCookHand', 'YouYuan', sans-serif;
  max-width: 300rpx;
  margin-bottom: 8rpx;
  overflow: hidden;
  color: #201613;
  font-size: 27rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-meta {
  display: flex;
  gap: 16rpx;
}

.dish-cal {
  color: #9F4F38;
  font-family: Arial, 'PingFang SC', sans-serif;
  font-size: 21rpx;
}

.dish-actions {
  flex: 0 0 104rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
}

.avail-switch {
  transform: scale(0.82);
  transform-origin: right top;
}

.action-btns {
  position: absolute;
  right: 18rpx;
  bottom: 16rpx;
  left: 184rpx;
  display: flex;
  gap: 8rpx;
}

.action-btn {
  flex: 1;
  min-height: 88rpx;
  padding: 0 14rpx;
  justify-content: center;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  border: 1rpx solid transparent;
  border-radius: 28rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.action-btn.edit {
  color: #356D86;
  background: #EDF8FD;
  border-color: #C8E5F1;
}

.action-btn.cook {
  color: #3B8B49;
  background: #EEF9EF;
  border-color: #CBE8CF;
}

.action-btn.delete {
  color: #8B817C;
  background: #F7F3F1;
  border-color: #DED4CF;
}

.empty-group {
  padding: 42rpx 32rpx;
  color: #7C8588;
  background: rgba(255, 253, 249, 0.82);
  border: 1rpx dashed rgba(113, 88, 74, 0.16);
  border-radius: 28rpx;
  font-size: 23rpx;
  text-align: center;
}

.fab {
  position: fixed;
  z-index: 100;
  right: 40rpx;
  bottom: calc(42rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #593B30;
  background: var(--color-primary, #FF9278);
  border: 2rpx solid #593B30;
  border-radius: 50%;
  box-shadow: 0 8rpx 20rpx rgba(255, 105, 119, 0.22);
  font-size: 48rpx;
}

.fab:active {
  opacity: 0.82;
  transform: scale(0.96);
}
