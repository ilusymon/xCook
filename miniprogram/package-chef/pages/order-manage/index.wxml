<view class="order-manage-page">
  <!-- 状态筛选 -->
  <view class="filter-tabs">
    <view
      class="filter-tab {{currentTab === index ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="value"
      bindtap="onTabChange"
      data-index="{{index}}"
    >
      {{item.label}}
      <view class="tab-badge" wx:if="{{item.count > 0}}">{{item.count}}</view>
    </view>
  </view>
  <view class="state-panel" wx:if="{{error}}"><text>{{error}}</text><button class="btn-secondary" bindtap="loadOrders">重新加载</button></view>

  <!-- 订单列表 -->
  <view class="orders" wx:if="{{orders.length > 0}}">
    <view class="order-card" wx:for="{{orders}}" wx:key="_id">
      <view class="order-header">
        <view class="order-left">
          <text class="order-number">{{item.orderNumber}}</text>
          <text class="order-time">{{item.createdAtText}}</text>
        </view>
        <order-status-tag status="{{item.status}}" />
      </view>

      <!-- 菜品列表 -->
      <view class="order-dishes">
        <view class="dish-row" wx:for="{{item.items}}" wx:for-item="dish" wx:key="itemIndex">
          <text class="dish-name">{{dish.dishName}}</text>
          <text class="dish-qty">x{{dish.quantity}}</text>
          <text class="dish-options" wx:if="{{dish.optionTags.length}}">{{dish.optionTags}}</text>
        </view>
      </view>

      <!-- 备注 -->
      <view class="order-note" wx:if="{{item.note}}">
        <text class="note-label">备注：</text>
        <text>{{item.note}}</text>
      </view>

      <!-- 操作按钮 -->
      <view class="order-actions">
        <text class="total-info">{{item.totalCalories}}kcal</text>
        <view class="action-buttons">
          <button
            class="action-btn accept cartoon-button cartoon-button--compact"
            wx:if="{{item.status === 'placed'}}"
            bindtap="acceptOrder"
            data-index="{{index}}"
            disabled="{{busy}}"
           hover-class="cartoon-button--pressed">接下愿望</button>
          <button
            class="action-btn cooking"
            bindtap="openOrder"
            data-index="{{index}}"
          >{{item.status === 'accepted' || item.status === 'cooking' ? '逐道制作' : '查看详情'}}</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="state-panel" wx:elif="{{loading}}">愿望单加载中...</view>
  <view class="empty-state" wx:elif="{{!error}}">
    <text class="empty-emoji">📦</text>
    <text class="empty-text">暂无愿望</text>
  </view>
  <button class="load-more" wx:if="{{hasMore}}" bindtap="loadMore" disabled="{{loading}}">{{loading ? '加载中...' : '加载更多愿望'}}</button>
</view>
