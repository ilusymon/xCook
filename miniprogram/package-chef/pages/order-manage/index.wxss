.order-manage-page { min-height: 100vh; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); background: var(--color-bg); }
.filter-tabs { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 24rpx 28rpx; }
.filter-tab { position: relative; flex: 1 1 100rpx; display: flex; align-items: center; justify-content: center; min-height: 76rpx; padding: 0 12rpx; border: 2rpx solid var(--color-text); border-radius: 20rpx; background: var(--color-bg-card); font-size: 24rpx; text-align: center; }
.filter-tab.active { background: var(--color-primary); }
.tab-badge { position: absolute; right: 4rpx; top: -12rpx; padding: 2rpx 8rpx; border: 1rpx solid var(--color-text); border-radius: 20rpx; background: #FFE293; font-size: 20rpx; }
.orders { padding: 0 28rpx; }
.order-card { padding: 26rpx; margin-bottom: 24rpx; border: 2rpx solid var(--color-text); border-radius: 26rpx; background: var(--color-bg-card); box-shadow: 4rpx 6rpx 0 #EEDBC0; }
.order-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 18rpx; margin-bottom: 18rpx; }
.order-left { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.order-number { font-size: 26rpx; }
.order-time { font-size: 22rpx; color: var(--color-text-secondary); }
.order-dishes { padding: 16rpx; border: 1rpx dashed var(--color-border); border-radius: 20rpx; background: var(--color-bg); }
.dish-row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8rpx; padding: 10rpx 0; }
.dish-name { font-family: 'XCookHand', 'YouYuan', sans-serif; font-size: 30rpx; }
.dish-qty { font-size: 26rpx; }
.dish-options { flex: 0 0 100%; font-size: 22rpx; color: var(--color-text-secondary); }
.order-note { padding: 18rpx; margin-top: 18rpx; border-radius: 20rpx; background: #FFE0D1; font-size: 24rpx; line-height: 1.6; word-break: break-all; }
.note-label { font-weight: 600; }
.order-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 22rpx; }
.total-info { font-size: 24rpx; color: var(--color-secondary); }
.action-buttons { display: flex; flex-wrap: wrap; gap: 12rpx; }
.action-btn { min-height: 88rpx; margin: 0; padding: 0 22rpx; border: 2rpx solid var(--color-text); border-radius: 44rpx; background: var(--color-primary); font-size: 26rpx; line-height: 84rpx; box-shadow: 0 4rpx 0 #E4C5A8; }
.action-btn.cooking { background: #BDDCED; }
.empty-emoji { font-size: 72rpx; }
.empty-text { font-size: 28rpx; }
