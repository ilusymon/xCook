@import '../../../styles/button-reset.wxss';
.option-picker {
  padding: 0 8rpx;
}

.option-group {
  margin-bottom: 28rpx;
}

.group-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.group-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text, #593B30);
  margin-right: 12rpx;
}

.group-type {
  font-size: 20rpx;
  color: var(--color-primary, #FF9278);
  background: var(--color-border, #B89A80);
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  margin-right: 8rpx;
}

.group-type.optional {
  color: var(--color-text-secondary, #8A7466);
  background: #F5F0F0;
}

.group-hint {
  font-size: 20rpx;
  color: var(--color-text-secondary, #8A7466);
}

.option-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 14rpx 28rpx;
  background: var(--color-bg, #FFF9EA);
  border: 2rpx solid var(--color-border, #B89A80);
  border-radius: 32rpx;
  transition: all 0.2s ease;
}

.option-item.selected {
  background: var(--color-primary, #FF9278);
  border-color: var(--color-primary, #FF9278);
  color: #593B30;
}

.option-item.selected .option-label {
  color: #593B30;
}

.option-label {
  font-size: 26rpx;
  color: var(--color-text, #593B30);
}

.option-item { min-height: 88rpx; margin: 0; padding: 16rpx 28rpx; box-sizing: border-box; line-height: 1.4; }
.option-item::after { display: none; }
.group-header { flex-wrap: wrap; gap: 8rpx; }
