<view class="checkout-page">
  <!-- 愿望摘要 -->
  <view class="section-card">
    <text class="section-title">愿望确认</text>
    <view class="order-items">
      <view class="order-item" wx:for="{{cart}}" wx:key="cartItemId">
        <text class="item-name">{{item.dishName}} x{{item.quantity}}</text>
      </view>
    </view>
    <view class="divider"></view>
    <view class="summary-row">
      <text>共 {{totalCount}} 道菜</text>
      <text class="cal-text">{{totalCalories}}kcal</text>
    </view>
  </view>

  <!-- 备注 -->
  <view class="section-card">
    <text class="section-title">想对厨师说...</text>
    <textarea
      class="note-input"
      placeholder="口味偏好、特殊要求等"
      value="{{note}}"
      bindinput="onNoteInput"
      maxlength="200"
    />
  </view>

  <!-- 提交愿望按钮 -->
  <view class="pay-btn-wrap">
    <view class="pay-btn" bindtap="placeOrder">
      <text>加入愿望单</text>
    </view>
  </view>
</view>
