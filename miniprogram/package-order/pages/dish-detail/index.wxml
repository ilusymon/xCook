<view class="detail-page">
  <view class="state-panel" wx:if="{{loading}}">菜品加载中...</view>
  <view class="state-panel" wx:elif="{{error}}"><text>{{error}}</text><button class="btn-secondary" bindtap="loadDish">重新加载</button></view>
  <block wx:else>
  <!-- 封面图 -->
  <view class="dish-hero-wrap"><dish-art cover-image="{{dish.coverImage}}" dish-name="{{dish.name}}" mode="aspectFit" /></view>

  <!-- 基本信息 -->
  <view class="info-card">
    <text class="dish-name">{{dish.name}}</text>
    <text class="dish-desc">{{dish.description}}</text>

    <view class="info-tags">
      <view class="info-tag calorie">{{dish.calories}}kcal</view>
      <view class="info-tag time" wx:if="{{dish.preparationTime}}">{{dish.preparationTime}}分钟</view>
      <view class="info-tag difficulty" wx:if="{{dish.difficulty}}">{{difficultyText}}</view>
    </view>

  </view>

  <!-- 选项选择 -->
  <view class="section-card" wx:if="{{dish.optionGroups && dish.optionGroups.length > 0}}">
    <text class="section-title">口味选择</text>
    <option-picker
      id="optionPicker"
      optionGroups="{{dish.optionGroups}}"
    />
  </view>

  <!-- 数量选择 -->
  <view class="section-card">
    <text class="section-title">数量</text>
    <view class="quantity-row">
      <button class="qty-btn" bindtap="decreaseQty" disabled="{{quantity <= 1}}" aria-label="减少数量">−</button>
      <text class="qty-value">{{quantity}}</text>
      <button class="qty-btn" bindtap="increaseQty" disabled="{{quantity >= 99}}" aria-label="增加数量">＋</button>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="total-info">
      <text class="total-label">营养参考</text>
      <text class="total-cal">{{totalCalories}}kcal</text>
    </view>
    <button class="add-cart-btn cartoon-button cartoon-button--compact" bindtap="addToCart" disabled="{{adding || dish.isDeleted || !dish.isAvailable}}" hover-class="cartoon-button--pressed">{{dish.isDeleted || !dish.isAvailable ? '暂未上架' : '放进小餐单'}}</button>
  </view>
  </block>
</view>
