.detail-page { min-height: 100vh; padding-bottom: calc(190rpx + env(safe-area-inset-bottom)); }
.dish-hero-wrap { position: relative; height: 400rpx; margin: 24rpx 28rpx; overflow: hidden; background: #FFF4D8; border: 2rpx solid var(--color-text); border-radius: 28rpx; }
.info-card, .section-card { margin: 18rpx 28rpx; padding: 28rpx; background: var(--color-bg-card); border: 2rpx solid var(--color-text); border-radius: 28rpx; box-shadow: 3rpx 5rpx 0 #EEDBC0; }
.dish-name {
  font-family: 'XCookHand', 'YouYuan', sans-serif; display: block; font-size: 36rpx; font-weight: 700; }
.dish-desc { display: block; margin-top: 16rpx; color: var(--color-text-secondary); line-height: 1.7; }
.info-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 24rpx; }
.info-tag { padding: 8rpx 18rpx; border-radius: 20rpx; font-size: 24rpx; }
.calorie { color: var(--color-secondary); background: #FFF4D8; }
.time { color: #356D86; background: #EDF8FD; }
.difficulty { color: var(--color-primary-dark); background: var(--color-primary-light); }
.section-title { display: block; }
.quantity-row { display: flex; align-items: center; justify-content: center; gap: 32rpx; }
.qty-btn { width: 88rpx; min-height: 88rpx; margin: 0; padding: 0; color: var(--color-primary-dark); background: var(--color-primary-light); border: 2rpx solid var(--color-text); border-radius: 50%; font-size: 36rpx; line-height: 86rpx; }
.qty-value { min-width: 64rpx; font-size: 34rpx; text-align: center; }
.bottom-bar { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; display: flex; gap: 28rpx; align-items: center; padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); background: var(--color-bg-card); border-top: 1rpx solid var(--color-border); border-radius: 28rpx 28rpx 0 0; }
.total-info { flex: 1; }
.total-label { display: block; color: var(--color-text-secondary); font-size: 24rpx; }
.total-cal { display: block; margin-top: 6rpx; color: var(--color-secondary); font-size: 30rpx; font-weight: 700; }
.add-cart-btn { min-height: 88rpx; margin: 0; padding: 0 36rpx; color: #593B30; background: var(--color-primary); border: 2rpx solid #593B30; border-radius: 44rpx; font-size: 28rpx; line-height: 86rpx; }
