<view class="detail-page">
  <view class="state-panel" wx:if="{{error}}"><text>{{error}}</text><button class="btn-secondary" bindtap="refreshProgress">重新加载</button></view>
  <view class="state-panel" wx:elif="{{loading}}">愿望进度加载中...</view>
  <block wx:if="{{wishlist._id}}">

  <view class="dish-card wishlist-summary">
    <view class="dish-copy">
      <text class="dish-name">这份小愿望 ♡</text><text class="remaining">{{wishlist.orderNumber}}</text>
      <text class="remaining">{{wishlist.items.length}} 道菜 · {{wishlist.totalCalories}} kcal · 更新于 {{updatedText}}</text>
    </view>
    <view class="status-pill">{{statusText}}</view>
  </view>

  <view class="progress-card" wx:if="{{wishlist.status !== 'cancelled'}}">
    <text class="section-title">愿望进度</text>
    <view class="progress-row">
      <view class="progress-node {{statusStep >= 0 ? 'active' : ''}}"><text class="progress-heart">{{statusStep >= 0 ? '♥' : '♡'}}</text><text>已许愿</text></view>
      <view class="line {{statusStep >= 1 ? 'active' : ''}}"></view>
      <view class="progress-node {{statusStep >= 1 ? 'active' : ''}}"><text class="progress-heart">{{statusStep >= 1 ? '♥' : '♡'}}</text><text>已接下</text></view>
      <view class="line {{statusStep >= 2 ? 'active' : ''}}"></view>
      <view class="progress-node {{statusStep >= 2 ? 'active' : ''}}"><text class="progress-heart">{{statusStep >= 2 ? '♥' : '♡'}}</text><text>制作中</text></view>
      <view class="line {{statusStep >= 3 ? 'active' : ''}}"></view>
      <view class="progress-node {{statusStep >= 3 ? 'active' : ''}}"><text class="progress-heart">{{statusStep >= 3 ? '♥' : '♡'}}</text><text>已完成</text></view>
    </view>
  </view>

  <view class="items-card">
    <text class="section-title">愿望菜单</text>
    <view class="wishlist-item" wx:for="{{wishlist.items}}" wx:key="index" bindtap="openDish" data-index="{{index}}">
      <view class="cover-wrap"><dish-art cover-image="{{item.coverImage}}" dish-name="{{item.dishName}}" /></view>
      <view class="dish-copy">
        <text class="dish-name">{{item.dishName}} × {{item.quantity}}</text>
        <view class="option-list" wx:if="{{item.optionTags.length}}">
          <text class="option-tag" wx:for="{{item.optionTags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
        </view>
        <text class="remaining">{{item.calories * item.quantity}} kcal · {{item.statusText}}</text>
      </view>
      <text class="item-action" wx:if="{{item.canCook}}">制作 ›</text>
      <text class="item-done" wx:elif="{{item.status === 'done'}}">完成 ✓</text>
    </view>
  </view>

  <view class="tip-card" wx:if="{{wishlist.note}}"><text class="section-title">愿望备注</text><text class="note-text">{{wishlist.note}}</text></view>
  <button class="cheer cartoon-button" wx:if="{{isChef && wishlist.status === 'placed'}}" bindtap="acceptWishlist" disabled="{{busy}}" hover-class="cartoon-button--pressed">接下这份愿望</button>
  <button class="cheer secondary" wx:elif="{{!isChef && (wishlist.status === 'placed' || wishlist.status === 'accepted')}}" bindtap="cancelWishlist" disabled="{{busy}}">取消愿望</button>
  <text class="flow-hint" wx:if="{{isChef && (wishlist.status === 'accepted' || wishlist.status === 'cooking')}}">点击菜品进入制作，全部菜品完成后愿望自动完成。</text>
  </block>
  <button class="cheer secondary" bindtap="goBack">返回愿望单</button>
</view>
