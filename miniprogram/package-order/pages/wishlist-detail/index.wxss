page { min-height: 100%; background: var(--color-bg); }
.detail-page { min-height: 100vh; padding: 24rpx 28rpx calc(60rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.dish-card, .progress-card, .items-card { margin-bottom: 22rpx; padding: 28rpx; border: 2rpx solid var(--color-text); border-radius: 22rpx 28rpx 20rpx 26rpx; background: var(--color-bg-card); box-shadow: 4rpx 6rpx 0 #EEDBC0; }
.wishlist-summary { display: flex; align-items: flex-start; gap: 18rpx; }
.dish-copy { flex: 1; min-width: 0; }
.dish-name { display: block; font-family: 'XCookHand', 'YouYuan', sans-serif; font-size: 32rpx; line-height: 1.4; }
.remaining { display: block; margin-top: 10rpx; font-size: 22rpx; color: var(--color-text-secondary); line-height: 1.5; }
.status-pill { flex-shrink: 0; padding: 8rpx 16rpx; border-radius: 20rpx; background: #FFE293; font-size: 22rpx; }
.progress-row { display: flex; align-items: flex-start; margin-top: 24rpx; }
.progress-node { width: 90rpx; display: flex; flex-direction: column; align-items: center; font-size: 22rpx; color: var(--color-text-secondary); white-space: nowrap; }
.progress-heart { margin-bottom: 8rpx; font-size: 44rpx; line-height: 1.2; color: var(--color-text); }
.progress-node.active .progress-heart { color: var(--color-primary); text-shadow: 1rpx 1rpx 0 var(--color-text); }
.progress-node.active { color: var(--color-text); }
.line { flex: 1; margin-top: 28rpx; border-top: 2rpx dashed var(--color-border); }
.line.active { border-color: var(--color-primary-dark); }
.wishlist-item { display: flex; align-items: center; gap: 18rpx; padding: 18rpx 0; border-bottom: 1rpx dashed var(--color-border); }
.wishlist-item:last-child { border: 0; }
.cover-wrap { flex-shrink: 0; width: 116rpx; height: 116rpx; border-radius: 18rpx; overflow: hidden; }
.option-list { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 10rpx; }
.option-tag { padding: 5rpx 12rpx; border-radius: 12rpx; background: #FFE4D8; font-size: 22rpx; }
.item-action, .item-done { flex-shrink: 0; font-size: 24rpx; color: var(--color-primary-dark); }
.item-done { color: var(--color-success); }
.tip-card { margin: 24rpx 0; padding: 24rpx; border: 2rpx dashed #C99A7D; border-radius: 22rpx; background: #FFE0D1; }
.note-text { display: block; margin-top: 14rpx; font-size: 26rpx; line-height: 1.7; word-break: break-all; }
.cheer { min-height: 88rpx; margin: 28rpx 0 0; padding: 0 24rpx; border: 2rpx solid var(--color-text); border-radius: 44rpx; background: var(--color-primary); font-family: 'XCookHand', 'YouYuan', sans-serif; font-size: 34rpx; line-height: 84rpx; box-shadow: 0 4rpx 0 #E4C5A8; }
.cheer.secondary { background: var(--color-bg-card); font-family: sans-serif; font-size: 28rpx; }
