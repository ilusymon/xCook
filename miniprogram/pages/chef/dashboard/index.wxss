.dashboard-page { min-height: 100vh; padding-bottom: calc(145rpx + env(safe-area-inset-bottom)); background: var(--color-bg); }
.dashboard-body { padding: 14rpx 28rpx; }
.stats-row { display: flex; gap: 16rpx; margin: 0 0 28rpx; }
.stat-card { flex: 1; min-width: 0; margin: 0; padding: 18rpx 12rpx; display: flex; align-items: center; justify-content: center; gap: 12rpx; border: 2rpx solid var(--color-text); border-radius: 24rpx; font-size: 24rpx; line-height: 1.4; box-shadow: 0 4rpx 0 #EEDBC0; }
.stat-card.waiting { background: #FFE293; }
.stat-card.cooking { background: #BDDCED; }
.stat-card.dishes { background: #FFD4C1; }
.stat-card image { flex-shrink: 0; width: 58rpx; height: 58rpx; }
.stat-value { display: block; font-size: 40rpx; }
.section-heading { display: flex; align-items: center; gap: 10rpx; margin: 26rpx 0 16rpx; font-family: 'XCookHand', 'YouYuan', sans-serif; font-size: 36rpx; }
.section-heading image { width: 48rpx; height: 48rpx; }
.section-heading .text-button { margin-left: auto; font-family: sans-serif; }
.request-card { margin-bottom: 18rpx; padding: 20rpx; background: var(--color-bg-card); border: 2rpx solid var(--color-text); border-radius: 26rpx; box-shadow: 0 4rpx 0 #EEDBC0; }
.request-heading { display: flex; justify-content: space-between; gap: 12rpx; padding-bottom: 12rpx; border-bottom: 1rpx dashed var(--color-border); font-size: 22rpx; }
.request-status { padding: 3rpx 16rpx; border-radius: 14rpx; background: #FFE293; }
.request-body { display: flex; align-items: center; gap: 18rpx; padding-top: 16rpx; }
.request-dishes { flex: 1; min-width: 0; display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.request-dish { flex: 1; min-width: 0; max-width: 146rpx; text-align: center; font-family: 'XCookHand', 'YouYuan', sans-serif; font-size: 24rpx; }
.request-art { width: 132rpx; height: 116rpx; margin: auto; overflow: hidden; border-radius: 18rpx; }
.more-dishes { font-size: 20rpx; color: var(--color-text-secondary); }
.start-button { flex-shrink: 0; width: 238rpx; margin: 0; padding: 0 18rpx; min-height: 92rpx; font-size: 32rpx; line-height: 92rpx; }
.action-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.action-item { position: relative; display: flex; align-items: center; flex: 0 0 calc(50% - 8rpx); min-width: 0; min-height: 158rpx; margin: 0; padding: 12rpx 18rpx 12rpx 4rpx; border: 2rpx solid var(--color-text); border-radius: 22rpx; box-sizing: border-box; background: var(--color-bg-card); text-align: left; line-height: 1.5; box-shadow: 0 3rpx 0 #EEDBC0; }
.action-art { flex-shrink: 0; width: 130rpx; height: 130rpx; }
.action-copy { flex: 1; font-family: 'XCookHand', 'YouYuan', sans-serif; font-size: 28rpx; }
.action-detail { display: block; font-family: sans-serif; font-size: 21rpx; color: var(--color-text-secondary); }
.arrow { position: absolute; right: 10rpx; bottom: 16rpx; font-size: 32rpx; }
.progress-link { margin-top: 22rpx; }
.quiet-kitchen { display: flex; flex-direction: column; align-items: center; padding: 28rpx 12rpx; font-size: 24rpx; color: var(--color-text-secondary); }
