.home-page { min-height: 100vh; background: var(--color-bg); padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.home-body { padding: 24rpx 32rpx; }
.home-note { display: block; margin-bottom: 24rpx; text-align: center; color: var(--color-text-secondary); font-size: 24rpx; }
.home-primary { width: 100%; box-sizing: border-box; display: flex; align-items: center; gap: 18rpx; margin: 0 0 22rpx; padding: 12rpx 24rpx 12rpx 8rpx; text-align: left; border: 3rpx solid var(--color-text); border-radius: 28rpx; background: #FFE293; font-family: 'XCookHand', 'YouYuan', sans-serif; font-size: 40rpx; line-height: 1.4; box-shadow: 4rpx 6rpx 0 #EEDBC0; }
.primary-art { width: 150rpx; height: 150rpx; }
.primary-detail { display: block; margin-top: 8rpx; font-family: sans-serif; font-size: 24rpx; }
.arrow { margin-left: auto; }
.home-grid { display: flex; gap: 20rpx; }
.home-item { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; margin: 0; padding: 18rpx; border: 2rpx solid var(--color-text); border-radius: 26rpx; background: var(--color-bg-card); font-family: 'XCookHand', 'YouYuan', sans-serif; font-size: 34rpx; line-height: 1.5; box-shadow: 3rpx 5rpx 0 #EEDBC0; }
.item-art { width: 160rpx; height: 140rpx; }
.item-detail { margin-top: 8rpx; font-family: sans-serif; font-size: 22rpx; color: var(--color-text-secondary); }
.home-record { width: 100%; box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin: 24rpx 0; padding: 20rpx 24rpx; border: 2rpx solid var(--color-text); border-radius: 24rpx; background: #DCEBF4; font-size: 28rpx; line-height: 1.5; }
.home-record image { width: 58rpx; height: 58rpx; }
.home-footer { display: block; text-align: center; margin-top: 32rpx; font-size: 22rpx; color: var(--color-text-secondary); }
