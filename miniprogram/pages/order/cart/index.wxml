<view class="cart-page">
  <!-- 顶部栏 -->
  <view class="top-bar">
    <home-btn />
    <text class="page-title">我的小餐单</text>
    <view class="top-bar-spacer"></view>
  </view>

  <!-- 购物车列表 -->
  <view class="cart-list" wx:if="{{cart.length > 0}}">
    <view class="cart-item" wx:for="{{cart}}" wx:key="cartItemId">
      <view class="item-cover"><dish-art cover-image="{{item.coverImage}}" dish-name="{{item.dishName}}" /></view>
      <view class="item-info">
        <text class="item-name">{{item.dishName}}</text>
        <!-- 已选选项 -->
        <view class="item-options" wx:if="{{item.optionTags.length > 0}}">
          <text class="option-tag" wx:for="{{item.optionTags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
        </view>
        <view class="item-bottom">
          <text class="item-calories">{{item.calories * item.quantity}}kcal</text>
          <view class="qty-control">
            <button class="qty-btn" bindtap="decreaseQty" data-id="{{item.cartItemId}}" aria-label="减少{{item.dishName}}">−</button>
            <text class="qty-value">{{item.quantity}}</text>
            <button class="qty-btn" bindtap="increaseQty" disabled="{{item.quantity >= 99}}" data-id="{{item.cartItemId}}" aria-label="增加{{item.dishName}}">＋</button>
          </view>
        </view>
      </view>
      <view class="delete-btn" bindtap="removeItem" data-id="{{item.cartItemId}}">✕</view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <view class="empty-art"><kitchen-art kind="categories" /></view>
    <text class="empty-text">小餐单还空着呢</text>
    <text class="empty-hint">去菜单看看吧～</text>
    <button class="btn-primary cartoon-button cartoon-button--compact" bindtap="goMenu" hover-class="cartoon-button--pressed">去选菜</button>
  </view>

  <!-- 底部愿望确认栏 -->
  <view class="checkout-bar" wx:if="{{cart.length > 0}}">
    <view class="checkout-info">
      <view class="checkout-row">
        <text class="checkout-label">共{{totalCount}} 份</text>
        <text class="checkout-cal">{{totalCalories}}kcal</text>
      </view>
    </view>
    <view class="clear-btn" bindtap="clearCart">清空</view>
    <button class="checkout-btn cartoon-button cartoon-button--compact" bindtap="goCheckout" hover-class="cartoon-button--pressed">确认愿望</button>
  </view>
</view>
