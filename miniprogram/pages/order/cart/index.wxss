.cart-page { min-height: 100vh; padding-bottom: calc(190rpx + env(safe-area-inset-bottom)); }
.top-bar { padding: 24rpx 28rpx; display: flex; align-items: center; justify-content: space-between; }
.page-title {
  font-family: 'XCookHand', 'YouYuan', sans-serif; font-size: 34rpx; font-weight: 700; }
.top-bar-spacer { width: 80rpx; }
.cart-list { padding: 0 28rpx; }
.cart-item { position: relative; display: flex; gap: 20rpx; margin-bottom: 18rpx; padding: 24rpx; background: var(--color-bg-card); border: 2rpx solid var(--color-text); border-radius: 28rpx; box-shadow: 3rpx 5rpx 0 #EEDBC0; }
.item-cover { overflow: hidden; flex: none; width: 132rpx; height: 132rpx; background: #FFF4D8; border-radius: 20rpx; }
.item-info { flex: 1; min-width: 0; padding-right: 20rpx; }
.item-name {
  font-family: 'XCookHand', 'YouYuan', sans-serif; display: block; font-size: 29rpx; font-weight: 700; }
.item-options { margin-top: 10rpx; display: flex; flex-wrap: wrap; gap: 8rpx; }
.option-tag { padding: 4rpx 10rpx; color: var(--color-primary-dark); background: var(--color-primary-light); border-radius: 12rpx; font-size: 22rpx; }
.item-bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 18rpx; }
.item-calories { color: var(--color-secondary); font-size: 24rpx; }
.qty-control { display: flex; align-items: center; }
.qty-btn { width: 80rpx; min-height: 80rpx; margin: 0; padding: 0; color: var(--color-primary-dark); background: var(--color-primary-light); border: 2rpx solid var(--color-text); border-radius: 50%; line-height: 78rpx; font-size: 32rpx; }
.qty-value { width: 56rpx; text-align: center; }
.delete-btn { position: absolute; top: 8rpx; right: 8rpx; width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; color: var(--color-text-secondary); }
.empty-emoji { font-size: 80rpx; }
.empty-text { font-size: 30rpx; font-weight: 700; }
.empty-hint { font-size: 24rpx; }
.checkout-bar { position: fixed; z-index: 10; bottom: 0; left: 0; right: 0; display: flex; gap: 16rpx; align-items: center; padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); background: var(--color-bg-card); border-top: 1rpx solid var(--color-border); border-radius: 28rpx 28rpx 0 0; }
.checkout-info { flex: 1; }
.checkout-row { display: flex; flex-direction: column; gap: 6rpx; }
.checkout-label { color: var(--color-text-secondary); font-size: 24rpx; }
.checkout-cal { color: var(--color-secondary); font-weight: 700; }
.clear-btn { padding: 20rpx 8rpx; color: var(--color-text-secondary); font-size: 24rpx; }
.checkout-btn { min-height: 88rpx; margin: 0; padding: 0 28rpx; color: #593B30; background: var(--color-primary); border: 2rpx solid #593B30; border-radius: 44rpx; font-size: 28rpx; line-height: 86rpx; }
.empty-art { width: 160rpx; height: 160rpx; }
