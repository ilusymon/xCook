<view class="menu-page">
  <view class="menu-heading"><storybook-header title="今天想吃什么？" subtitle="点一道喜欢的，让大厨为你做。" scene="menu" compact show-search bind:hometap="goHome" bind:searchtap="toggleSearch" /></view>
  <view class="search-row" wx:if="{{searchVisible}}">
    <image src="/images/cartoon/search.svg" mode="aspectFit" />
    <input class="search-input" value="{{keyword}}" bindinput="onSearchInput" placeholder="搜索菜名或描述" focus="{{true}}" maxlength="64" confirm-type="search" aria-label="搜索菜品" />
  </view>
  <view class="menu-columns">
    <scroll-view class="category-tabs" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{categoryScrollTo}}" scroll-with-animation>
      <view class="category-track" aria-role="tablist" aria-label="菜品分类">
        <view wx:for="{{categories}}" wx:key="_id" id="category-{{item._id}}" class="category-item {{currentCategory === index ? 'active' : ''}}" bindtap="onCategoryTap" data-index="{{index}}" hover-class="category-item-pressed" aria-role="tab" aria-selected="{{currentCategory === index}}">{{item.name}}</view>
      </view>
    </scroll-view>
    <scroll-view class="dish-list" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{dishScrollTo}}" bindscroll="onDishScroll" bindtouchstart="onDishTouchStart">
      <view id="dish-list-top"></view>
      <view wx:for="{{dishSections}}" wx:key="categoryId" wx:for-item="section" class="dish-section" id="dish-section-{{section.categoryId}}">
        <text class="dish-section-title">{{section.categoryName}}</text>
        <view class="menu-dish-card" wx:for="{{section.dishes}}" wx:key="_id" wx:for-item="dish" bindtap="onDishTap" data-id="{{dish._id}}" aria-label="查看{{dish.name}}详情">
          <view class="dish-art-box"><dish-art cover-image="{{dish.coverImage}}" dish-name="{{dish.name}}" /></view>
          <view class="dish-copy">
            <text class="dish-name">{{dish.name}}</text>
            <text class="dish-description">{{dish.description || '认真做的一道好味道。'}}</text>
            <text class="dish-calories">{{dish.calories}} kcal</text>
          </view>
          <view class="quantity-control">
            <text wx:if="{{dish.quantity}}" class="quantity-value">{{dish.quantity}}</text>
            <button class="quantity-button" catchtap="onQuantityTap" data-id="{{dish._id}}" data-delta="1" aria-label="增加{{dish.name}}"><image class="quantity-circle" src="/images/cartoon/button-add.svg" mode="aspectFit" aria-hidden="true" /></button>
          </view>
        </view>
      </view>
      <view class="state-panel" wx:if="{{loading}}">菜单加载中…</view>
      <view class="state-panel" wx:elif="{{error}}"><text>{{error}}</text><button class="btn-secondary" bindtap="loadMenuData">重新加载</button></view>
      <view class="state-panel" wx:elif="{{!dishSections.length}}"><view class="empty-art"><kitchen-art kind="add" /></view><text>{{keyword ? '没有找到这道菜，试试其他关键词' : '这里还没有菜品，来添一道拿手菜吧'}}</text><button class="btn-primary cartoon-button cartoon-button--compact" wx:if="{{!keyword}}" bindtap="goChef" hover-class="cartoon-button--pressed">进入厨房</button></view>
    </scroll-view>
  </view>
  <view class="cart-panel-mask" wx:if="{{cartPanelVisible}}" catchtap="closeCartPanel"></view>
  <view class="cart-panel" wx:if="{{cartPanelVisible}}" catchtap="stopTap">
    <view class="cart-panel-heading"><text>我的小餐单 · {{cartSummary.totalCount}} 份</text><button class="text-button" bindtap="goCart">编辑餐单 ›</button></view>
    <scroll-view class="cart-panel-list" scroll-y style="max-height: {{cartPanelHeight}}rpx;">
      <view class="selected-row" wx:for="{{selectedDishes}}" wx:key="cartItemId">
        <view class="selected-art"><dish-art cover-image="{{item.coverImage}}" dish-name="{{item.dishName}}" /></view>
        <view class="selected-copy"><text>{{item.dishName}}</text><text class="selected-options" wx:for="{{item.optionTags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text></view>
        <view class="selected-quantity"><button catchtap="onQuantityTap" data-cart-id="{{item.cartItemId}}" data-delta="-1" aria-label="减少{{item.dishName}}">−</button><text>{{item.quantity}}</text><button catchtap="onQuantityTap" data-cart-id="{{item.cartItemId}}" data-delta="1" aria-label="增加{{item.dishName}}">＋</button></view>
      </view>
    </scroll-view>
  </view>
  <view class="wish-bar">
    <button class="wish-summary" bindtap="toggleCartPanel" aria-label="查看已选菜品">
      <view class="basket"><kitchen-art kind="categories" /></view>
      <view><text>已选 <text class="count">{{cartSummary.totalCount}}</text> 份</text><text class="summary-calories">{{cartSummary.totalCalories}} kcal · 点击查看</text></view>
    </button>
    <button class="confirm-button cartoon-button cartoon-button--compact" bindtap="goCheckout" hover-class="cartoon-button--pressed">确认愿望</button>
  </view>
  <bottom-navigation active="menu" />
</view>
