<view class="menu-page">
  <!-- 参考图顶部：系统状态栏与胶囊由小程序保留，这里只绘制页面导航和角色区 -->
  <view class="hero-header">
    <view class="custom-navigation" style="height: {{navigationHeight}}px; padding-top: {{statusBarHeight}}px;">
      <view
        class="navigation-actions"
        style="top: {{navigationContentTop}}px; height: {{navigationContentHeight}}px;"
      >
        <button
          class="navigation-icon-button"
          hover-class="navigation-icon-button--pressed"
          bindtap="goHome"
          aria-label="返回首页"
        >
          <image class="home-icon" src="/images/menu/home.png" mode="aspectFit" />
        </button>

        <button
          class="navigation-icon-button"
          hover-class="navigation-icon-button--pressed"
          aria-label="搜索菜品"
        >
          <image class="search-icon" src="/images/menu/search.png" mode="aspectFit" />
        </button>
      </view>

      <view
        class="navigation-title"
        style="top: {{navigationContentTop}}px; height: {{navigationContentHeight}}px;"
      >
        <text class="page-title">Couple Order</text>
      </view>
    </view>

    <view class="role-stage">
      <view class="role-pill role-pill--girl"><text>我是吃货</text></view>
      <image class="role-person role-person--girl" src="/images/menu/01_chef_girl.png" mode="aspectFit" aria-hidden="true" />

      <image class="role-heart" src="/images/menu/03_heart.png" mode="aspectFit" aria-hidden="true" />

      <view class="role-pill role-pill--boy"><text>我是大厨</text></view>
      <image class="role-person role-person--boy" src="/images/menu/02_chef_boy.png" mode="aspectFit" aria-hidden="true" />
    </view>
  </view>

  <view class="menu-body">
    <view class="gingham-grid" aria-hidden="true">
      <image
        class="gingham-tile"
        wx:for="{{ginghamTiles}}"
        wx:key="*this"
        src="/images/menu/blue-gingham-background.png"
        mode="scaleToFill"
      />
    </view>

    <view class="menu-content">
      <!-- 横向分类胶囊 -->
      <scroll-view
        class="category-tabs"
        scroll-x
        enhanced
        show-scrollbar="{{false}}"
        scroll-with-animation
        scroll-into-view="{{categoryScrollTo}}"
        aria-role="tablist"
        aria-label="菜品分类"
      >
        <view class="category-track" style="width: {{categoryTrackWidth}}rpx;">
          <button
            class="category-item {{currentCategory === index ? 'active' : ''}}"
            wx:for="{{categories}}"
            wx:key="_id"
            id="side_{{item._id}}"
            hover-class="category-item--pressed"
            bindtap="onCategoryTap"
            data-index="{{index}}"
            data-id="{{item._id}}"
            aria-role="tab"
            aria-label="{{item.name}}"
          >
            <image class="category-icon" src="{{item.icon}}" mode="aspectFit" aria-hidden="true" />
            <text class="category-label">{{item.name}}</text>
          </button>
        </view>
      </scroll-view>

      <!-- 参考图菜品列表 -->
      <scroll-view
        class="dish-list"
        scroll-y
        enhanced
        show-scrollbar="{{false}}"
        scroll-with-animation
        scroll-into-view="{{scrollToView}}"
        bindscroll="onDishScroll"
      >
        <view class="dish-list-inner">
          <view
            class="dish-section"
            wx:for="{{dishSections}}"
            wx:key="categoryId"
            wx:for-item="section"
            id="dish-section-{{section.categoryId}}"
          >
            <view class="menu-dish-card" wx:for="{{section.dishes}}" wx:key="_id" wx:for-item="dish">
              <view class="dish-art-box">
                <image
                  class="dish-art"
                  src="{{dish.image}}"
                  mode="aspectFit"
                  style="width: {{dish.artWidth}}rpx; height: {{dish.artHeight}}rpx;"
                  aria-hidden="true"
                />
              </view>

              <image class="dish-favorite" src="/images/menu/03_heart.png" mode="aspectFit" aria-hidden="true" />

              <view class="dish-copy">
                <text class="dish-name">{{dish.name}}</text>
                <text class="dish-description">{{dish.description}}</text>
                <text class="dish-price">¥ {{dish.price}}</text>
              </view>

              <view class="quantity-control" aria-label="{{dish.name}}数量">
                <button
                  class="quantity-button"
                  disabled="{{dish.quantity === 0}}"
                  hover-class="quantity-button--pressed"
                  catchtap="onQuantityTap"
                  data-id="{{dish._id}}"
                  data-delta="-1"
                  aria-label="减少{{dish.name}}"
                >
                  <view class="quantity-icon-circle">
                    <image class="quantity-icon" src="/images/menu/remove.svg" mode="aspectFit" />
                  </view>
                </button>

                <text class="quantity-value">{{dish.quantity}}</text>

                <button
                  class="quantity-button"
                  hover-class="quantity-button--pressed"
                  catchtap="onQuantityTap"
                  data-id="{{dish._id}}"
                  data-delta="1"
                  aria-label="增加{{dish.name}}"
                >
                  <view class="quantity-icon-circle quantity-icon-circle--add">
                    <image class="quantity-icon" src="/images/menu/add.svg" mode="aspectFit" />
                  </view>
                </button>
              </view>
            </view>

            <view class="section-empty" wx:if="{{section.dishes.length === 0}}">暂无菜品</view>
          </view>

          <view class="menu-loading" wx:if="{{loading}}">菜单加载中...</view>
          <view class="empty-hint" wx:if="{{!loading && categories.length === 0}}">暂无可用分类</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 选中菜品后显示结算栏。 -->
  <view class="checkout-bar" wx:if="{{cartSummary.totalCount > 0}}">
    <view class="checkout-art-wrap" aria-hidden="true">
      <image class="checkout-art" src="/images/menu/15_checkout_couple.png" mode="aspectFit" />
      <view class="checkout-badge" wx:if="{{cartSummary.totalCount > 0}}">{{cartSummary.totalCount}}</view>
    </view>

    <view class="checkout-summary">
      <text class="checkout-total">¥ {{cartSummary.totalPrice}}</text>
      <text class="checkout-discount">已优惠 <text class="checkout-discount-value">¥ {{discount}}</text></text>
    </view>

    <button
      class="checkout-button"
      disabled="{{cartSummary.totalCount === 0}}"
      hover-class="checkout-button--pressed"
      bindtap="goCheckout"
      aria-label="去结算"
    >去结算</button>
  </view>

  <!-- 参考图底部导航；仅菜单页隐藏系统 TabBar，离开后立即恢复。 -->
  <view class="bottom-navigation" aria-role="navigation" aria-label="底部导航">
    <button
      class="bottom-nav-item {{index === 0 ? 'active' : ''}}"
      wx:for="{{bottomNavigation}}"
      wx:key="key"
      hover-class="bottom-nav-item--pressed"
      bindtap="onBottomNavTap"
      data-key="{{item.key}}"
      aria-label="{{item.label}}"
    >
      <view class="bottom-nav-icon-wrap">
        <image
          class="bottom-nav-icon"
          src="{{item.icon}}"
          mode="aspectFit"
          style="width: {{item.iconWidth}}rpx; height: {{item.iconHeight}}rpx;"
          aria-hidden="true"
        />
      </view>
      <text class="bottom-nav-label">{{item.label}}</text>
    </button>
  </view>
</view>
