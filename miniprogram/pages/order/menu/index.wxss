page {
  height: 100vh;
  overflow: hidden;
}

.menu-page {
  height: 100vh;
  background: #DFF4FF;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.hero-header {
  position: relative;
  flex: 0 0 292rpx;
  width: 100%;
  height: 292rpx;
  overflow: hidden;
  background: #DFF4FF;
}

.custom-navigation {
  position: relative;
  z-index: 4;
  width: 100%;
  box-sizing: border-box;
}

.navigation-actions {
  position: absolute;
  left: 36rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.navigation-icon-button {
  width: 58rpx;
  min-width: 58rpx;
  height: 58rpx;
  min-height: 58rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(38, 45, 50, 0.06);
  border-radius: 50%;
  box-sizing: border-box;
}

.navigation-icon-button::after {
  display: none;
}

.navigation-icon-button--pressed {
  opacity: 0.72;
  transform: scale(0.96);
}

.home-icon {
  width: 42rpx;
  height: 39rpx;
}

.search-icon {
  width: 43rpx;
  height: 43rpx;
}

.navigation-title {
  position: absolute;
  left: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translateX(-50%);
  pointer-events: none;
}

.page-title {
  color: #24130E;
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.role-stage {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 145rpx;
}

.role-pill {
  position: absolute;
  top: 58rpx;
  height: 75rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  color: #1E1714;
  background: rgba(255, 253, 249, 0.95);
  border: 1rpx solid rgba(126, 105, 92, 0.08);
  border-radius: 38rpx;
  box-shadow: 0 5rpx 14rpx rgba(94, 143, 165, 0.08);
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.role-pill--girl {
  left: 74rpx;
  width: 241rpx;
  padding-left: 119rpx;
}

.role-pill--boy {
  right: 74rpx;
  width: 260rpx;
  padding-left: 142rpx;
}

.role-person {
  position: absolute;
  z-index: 2;
  bottom: -3rpx;
}

.role-person--girl {
  left: 45rpx;
  width: 144rpx;
  height: 134rpx;
}

.role-person--boy {
  right: 198rpx;
  width: 133rpx;
  height: 132rpx;
}

.role-heart {
  position: absolute;
  top: 78rpx;
  left: 352rpx;
  width: 46rpx;
  height: 41rpx;
}

.menu-body {
  position: relative;
  flex: 1;
  min-height: 0;
  overflow: hidden;
  border-radius: 38rpx 38rpx 0 0;
  background: #EAF8FF;
}

/* 使用真实格纹图片平铺，保留参考图里的水彩纸张质感。 */
.gingham-grid {
  position: absolute;
  z-index: 0;
  top: 0;
  left: 0;
  width: 848rpx;
  display: flex;
  flex-wrap: wrap;
  align-content: flex-start;
  pointer-events: none;
}

.gingham-tile {
  flex: 0 0 212rpx;
  width: 212rpx;
  height: 212rpx;
}

.menu-content {
  position: relative;
  z-index: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.category-tabs {
  flex: 0 0 104rpx;
  width: calc(100% - 72rpx);
  height: 104rpx;
  margin: 32rpx auto 18rpx;
  overflow: hidden;
  box-sizing: border-box;
  background: #FFFFFF;
  border: 1rpx solid rgba(113, 89, 76, 0.06);
  border-radius: 52rpx;
  box-shadow: 0 5rpx 14rpx rgba(73, 117, 139, 0.07);
}

.category-track {
  height: 104rpx;
  display: inline-flex;
  align-items: stretch;
  vertical-align: top;
}

.category-item {
  position: relative;
  flex: 0 0 134rpx;
  width: 134rpx;
  min-height: 104rpx;
  margin: 0;
  padding: 10rpx 0 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #1E1714;
  background: transparent;
  border: 0;
  border-radius: 0;
  box-sizing: border-box;
}

.category-item::after {
  position: absolute;
  top: 19rpx;
  right: 0;
  width: 1rpx;
  height: 66rpx;
  background: rgba(111, 88, 76, 0.10);
  border: 0;
  border-radius: 0;
}

.category-item:last-child::after,
.category-item.active::after {
  display: none;
}

.category-item.active {
  color: #FF6C78;
  background: #FFFDF9;
  border: 1rpx solid rgba(255, 122, 132, 0.44);
  border-radius: 46rpx;
  box-shadow: 0 5rpx 13rpx rgba(255, 112, 126, 0.08);
}

.category-item--pressed {
  opacity: 0.76;
}

.category-icon {
  width: 49rpx;
  height: 45rpx;
}

.category-label {
  margin-top: 5rpx;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
  letter-spacing: 1rpx;
}

/* 菜品列表 */
.dish-list {
  flex: 1;
  min-height: 0;
  min-width: 0;
  box-sizing: border-box;
}

.dish-list-inner {
  box-sizing: border-box;
  padding: 0 36rpx;
  /* 结算栏总占位 + 24rpx 呼吸间距，并覆盖全面屏安全区。 */
  padding-bottom: calc(232rpx + env(safe-area-inset-bottom));
}

.dish-section {
  width: 100%;
}

.section-empty {
  height: 88rpx;
  margin-bottom: 7rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #718088;
  background: rgba(255, 253, 249, 0.84);
  border: 1rpx dashed rgba(113, 88, 74, 0.16);
  border-radius: 26rpx;
  box-sizing: border-box;
  font-size: 22rpx;
}

.menu-loading {
  padding: 64rpx 40rpx;
  color: #6F7F86;
  font-size: 24rpx;
  text-align: center;
}

.menu-dish-card {
  position: relative;
  width: 100%;
  height: 140rpx;
  margin-bottom: 7rpx;
  padding: 14rpx 20rpx;
  display: flex;
  box-sizing: border-box;
  overflow: visible;
  color: #201613;
  background: rgba(255, 253, 249, 0.98);
  border: 1rpx solid rgba(113, 88, 74, 0.06);
  border-radius: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(76, 112, 128, 0.07);
}

.dish-art-box {
  flex: 0 0 138rpx;
  width: 138rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #FFF4D8;
  border-radius: 18rpx;
}

.dish-art {
  display: block;
}

.dish-favorite {
  position: absolute;
  z-index: 2;
  top: 7rpx;
  left: 131rpx;
  width: 36rpx;
  height: 32rpx;
}

.dish-copy {
  flex: 1;
  min-width: 0;
  height: 112rpx;
  margin-left: 29rpx;
  padding-top: 9rpx;
  box-sizing: border-box;
}

.dish-name,
.dish-description,
.dish-price {
  display: block;
  white-space: nowrap;
}

.dish-name {
  max-width: 390rpx;
  overflow: hidden;
  color: #201613;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 32rpx;
  letter-spacing: 2rpx;
  text-overflow: ellipsis;
}

.dish-description {
  max-width: 375rpx;
  margin-top: 4rpx;
  overflow: hidden;
  color: #7C7B79;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 19rpx;
  font-weight: 400;
  line-height: 26rpx;
  letter-spacing: 2rpx;
  text-overflow: ellipsis;
}

.dish-price {
  margin-top: 4rpx;
  color: #FF6E79;
  font-family: Arial, 'PingFang SC', sans-serif;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 30rpx;
  letter-spacing: 1rpx;
}

.quantity-control {
  position: absolute;
  right: 22rpx;
  bottom: 16rpx;
  width: 162rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.90);
  border: 1rpx solid #F0E2DA;
  border-radius: 27rpx;
}

.quantity-button {
  width: 52rpx;
  min-width: 52rpx;
  height: 52rpx;
  min-height: 52rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: 0;
  border-radius: 50%;
  box-sizing: border-box;
}

.quantity-button::after {
  display: none;
}

.quantity-button[disabled] {
  opacity: 0.78;
  background: transparent;
}

.quantity-button--pressed {
  transform: scale(0.90);
}

.quantity-icon-circle {
  width: 38rpx;
  height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: #FBFCFA;
  border: 1rpx solid #E5E6E2;
  border-radius: 50%;
}

.quantity-icon-circle--add {
  background: #FFFFFF;
  border-color: #BFA99E;
}

.quantity-icon {
  width: 18rpx;
  height: 18rpx;
}

.quantity-value {
  min-width: 30rpx;
  color: #201613;
  font-family: Arial, sans-serif;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1;
  text-align: center;
}

.empty-hint {
  text-align: center;
  padding: 56rpx 40rpx;
  font-size: 24rpx;
  color: #6F7F86;
}

/* 结算栏 */
.checkout-bar {
  position: fixed;
  z-index: 20;
  right: 36rpx;
  /* 与底部导航保持 24rpx 间距。 */
  bottom: calc(112rpx + env(safe-area-inset-bottom));
  left: 36rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  color: #211713;
  background: rgba(255, 253, 249, 0.98);
  border: 1rpx solid rgba(113, 88, 74, 0.08);
  border-radius: 33rpx;
  box-shadow: 0 -5rpx 16rpx rgba(66, 105, 123, 0.08);
}

.checkout-art-wrap {
  position: absolute;
  bottom: 1rpx;
  left: 14rpx;
  width: 160rpx;
  height: 114rpx;
}

.checkout-art {
  width: 160rpx;
  height: 114rpx;
}

.checkout-badge {
  position: absolute;
  top: -7rpx;
  right: -1rpx;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 5rpx;
  box-sizing: border-box;
  color: #FFFFFF;
  background: #FF7180;
  border: 2rpx solid #FFFFFF;
  border-radius: 18rpx;
  font-family: Arial, sans-serif;
  font-size: 21rpx;
  font-weight: 500;
  line-height: 30rpx;
  text-align: center;
}

.checkout-summary {
  position: absolute;
  left: 205rpx;
  top: 19rpx;
  display: flex;
  flex-direction: column;
}

.checkout-total {
  color: #FF6876;
  font-family: Arial, sans-serif;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 36rpx;
  white-space: nowrap;
}

.checkout-discount {
  margin-top: 3rpx;
  color: #716D6A;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 18rpx;
  line-height: 22rpx;
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.checkout-discount-value {
  color: #FF6876;
}

.checkout-button {
  position: absolute;
  top: 17rpx;
  right: 28rpx;
  width: 193rpx;
  min-height: 62rpx;
  height: 62rpx;
  margin: 0;
  padding: 0;
  color: #FFFFFF;
  background: #FF7180;
  border: 1rpx solid #32211B;
  border-radius: 31rpx;
  box-sizing: border-box;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 60rpx;
  letter-spacing: 3rpx;
  text-align: center;
  box-shadow: 0 4rpx 9rpx rgba(255, 105, 119, 0.16);
}

.checkout-button::after {
  display: none;
}

.checkout-button[disabled] {
  color: rgba(255, 255, 255, 0.92);
  background: #D8CAC6;
  border-color: #BBAEA9;
}

.checkout-button--pressed {
  opacity: 0.82;
  transform: scale(0.98);
}

/* 底部四栏导航 */
.bottom-navigation {
  position: fixed;
  z-index: 19;
  right: 0;
  bottom: 0;
  left: 0;
  height: calc(88rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  box-sizing: border-box;
  background: rgba(237, 249, 255, 0.98);
  border-top: 1rpx solid rgba(117, 151, 165, 0.14);
  box-shadow: 0 -4rpx 13rpx rgba(75, 114, 131, 0.05);
}

.bottom-nav-item {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 6rpx 0 4rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  color: #716D6A;
  background: transparent;
  border: 0;
  border-radius: 0;
  box-sizing: border-box;
}

.bottom-nav-item::after {
  display: none;
}

.bottom-nav-item--pressed {
  opacity: 0.72;
}

.bottom-nav-icon-wrap {
  width: 64rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bottom-nav-icon {
  display: block;
}

.bottom-nav-label {
  height: 27rpx;
  padding: 0 2rpx 2rpx;
  box-sizing: border-box;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 24rpx;
  letter-spacing: 2rpx;
  white-space: nowrap;
}

.bottom-nav-item.active {
  color: #241713;
}

.bottom-nav-item.active .bottom-nav-label {
  border-bottom: 2rpx solid #241713;
  font-weight: 600;
}
