page {
  height: 100vh;
  overflow: hidden;
}

.menu-page {
  height: 100vh;
  background: #DFF4FF;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.hero-header {
  position: relative;
  flex: 0 0 auto;
  width: 100%;
  overflow: hidden;
  background: #DFF4FF;
}

.hero-art {
  display: block;
  width: 100%;
  height: 180rpx;
}

.custom-navigation {
  position: relative;
  z-index: 4;
  width: 100%;
  box-sizing: border-box;
  background: #DFF4FF;
}

.navigation-actions {
  position: absolute;
  z-index: 5;
  left: 36rpx;
  width: 164rpx;
  display: flex;
  align-items: center;
  padding: 0 8rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(83, 65, 53, 0.12);
  border-radius: 40rpx;
  box-sizing: border-box;
}

.navigation-icon-button {
  flex: 1;
  width: auto;
  min-width: 0;
  height: 100%;
  min-height: 64rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: 0;
  border-radius: 0;
  box-sizing: border-box;
}

.navigation-icon-button + .navigation-icon-button {
  border-left: 1rpx solid rgba(83, 65, 53, 0.12);
}

.navigation-icon-button::after {
  display: none;
}

.navigation-icon-button--pressed {
  opacity: 0.72;
  transform: scale(0.96);
}

.home-icon {
  width: 42rpx;
  height: 39rpx;
}

.search-icon {
  width: 38rpx;
  height: 38rpx;
}

.navigation-title {
  position: absolute;
  z-index: 4;
  left: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translateX(-50%);
  pointer-events: none;
}

.page-title {
  color: #24130E;
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.menu-body {
  position: relative;
  z-index: 2;
  flex: 1;
  min-height: 0;
  margin-top: -18rpx;
  overflow: hidden;
  border-radius: 28rpx 28rpx 0 0;
  background: #EAF8FF;
}

.menu-content {
  position: relative;
  z-index: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.menu-content--split {
  flex-direction: row;
}

.category-tabs {
  flex: 0 0 104rpx;
  width: calc(100% - 72rpx);
  height: 104rpx;
  margin: 32rpx auto 18rpx;
  overflow: hidden;
  box-sizing: border-box;
  background: #FFFFFF;
  border: 1rpx solid rgba(113, 89, 76, 0.06);
  border-radius: 52rpx;
  box-shadow: 0 5rpx 14rpx rgba(73, 117, 139, 0.07);
}

.category-track {
  height: 104rpx;
  display: inline-flex;
  align-items: stretch;
  vertical-align: top;
}

.category-item {
  position: relative;
  flex: 0 0 134rpx;
  width: 134rpx;
  min-height: 104rpx;
  margin: 0;
  padding: 10rpx 0 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #1E1714;
  background: transparent;
  border: 0;
  border-radius: 0;
  box-sizing: border-box;
}

.category-item::after {
  position: absolute;
  top: 19rpx;
  right: 0;
  width: 1rpx;
  height: 66rpx;
  background: rgba(111, 88, 76, 0.10);
  border: 0;
  border-radius: 0;
}

.category-item:last-child::after,
.category-item.active::after {
  display: none;
}

.category-item.active {
  color: #FF6C78;
  background: #FFFDF9;
  border: 1rpx solid rgba(255, 122, 132, 0.44);
  border-radius: 46rpx;
  box-shadow: 0 5rpx 13rpx rgba(255, 112, 126, 0.08);
}

.category-item--pressed {
  opacity: 0.76;
}

.category-icon {
  width: 49rpx;
  height: 45rpx;
}

.category-label {
  margin-top: 5rpx;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
  letter-spacing: 1rpx;
}

/* 旧版交互：左侧分类独立滚动，右侧菜品滚动时联动高亮。 */
.menu-content--split .category-tabs {
  flex: 0 0 180rpx;
  width: 180rpx;
  height: 100%;
  margin: 0;
  background: rgba(255, 253, 249, 0.72);
  border: 0;
  border-right: 1rpx solid rgba(117, 104, 96, 0.08);
  border-radius: 0;
  box-shadow: none;
}

.menu-content--split .category-track {
  min-height: 100%;
  height: auto;
  padding-top: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  box-sizing: border-box;
}

.menu-content--split .category-item {
  z-index: 0;
  flex: 0 0 104rpx;
  width: calc(100% - 20rpx);
  min-height: 96rpx;
  margin: 4rpx 10rpx;
  padding: 10rpx 0 8rpx;
  overflow: hidden;
  border-radius: 24rpx;
}

.menu-content--split .category-item::before,
.menu-content--split .category-item::after {
  display: none;
}

.category-active-bar {
  display: none;
}

.menu-content--split .category-active-bar {
  position: absolute;
  z-index: 2;
  top: 50%;
  left: 0;
  width: 6rpx;
  height: 44rpx;
  display: block;
  background: #FF7180;
  border-radius: 0 5rpx 5rpx 0;
  opacity: 0;
  transform: translateY(-50%);
}

.menu-content--split .category-item.active {
  z-index: 1;
  color: #FF6C78;
  background: #EAF8FF;
  border: 0;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(76, 112, 128, 0.08);
}

.menu-content--split .category-item.active .category-active-bar {
  opacity: 1;
}

.menu-content--split .category-icon {
  position: relative;
  z-index: 2;
  width: 45rpx;
  height: 42rpx;
}

.menu-content--split .category-label {
  position: relative;
  z-index: 2;
  font-size: 22rpx;
}

/* 菜品列表 */
.dish-list {
  flex: 1;
  min-height: 0;
  min-width: 0;
  box-sizing: border-box;
}

.menu-content--split .dish-list {
  background: transparent;
}

.dish-list-inner {
  box-sizing: border-box;
  padding: 0 36rpx;
  /* 固定结算栏上方保留可滚动空间，最后一张菜品卡不会被遮挡。 */
  padding-bottom: calc(276rpx + env(safe-area-inset-bottom));
}

.dish-section {
  width: 100%;
}

.dish-section-title {
  padding: 12rpx 8rpx 8rpx;
  color: #493B37;
  font-size: 25rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.menu-content--split .dish-list-inner {
  padding-right: 20rpx;
  padding-left: 20rpx;
}

.section-empty {
  height: 88rpx;
  margin-bottom: 7rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #718088;
  background: rgba(255, 253, 249, 0.84);
  border: 1rpx dashed rgba(113, 88, 74, 0.16);
  border-radius: 26rpx;
  box-sizing: border-box;
  font-size: 22rpx;
}

.menu-loading {
  padding: 64rpx 40rpx;
  color: #6F7F86;
  font-size: 24rpx;
  text-align: center;
}

.menu-dish-card {
  position: relative;
  width: 100%;
  height: 154rpx;
  margin-bottom: 14rpx;
  padding: 16rpx 20rpx;
  display: flex;
  box-sizing: border-box;
  overflow: visible;
  color: #201613;
  background: rgba(255, 253, 249, 0.98);
  border: 1rpx solid rgba(113, 88, 74, 0.06);
  border-radius: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(76, 112, 128, 0.08);
}

.dish-art-box {
  flex: 0 0 138rpx;
  width: 138rpx;
  height: 122rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #FFF4D8;
  border-radius: 18rpx;
}

.dish-art {
  display: block;
  width: 100%;
  height: 100%;
}

.dish-copy {
  flex: 1;
  min-width: 0;
  height: 122rpx;
  margin-left: 29rpx;
  padding-top: 9rpx;
  box-sizing: border-box;
}

.dish-name,
.dish-description,
.dish-calories {
  display: block;
  white-space: nowrap;
}

.dish-name {
  max-width: 390rpx;
  overflow: hidden;
  color: #201613;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 32rpx;
  letter-spacing: 2rpx;
  text-overflow: ellipsis;
}

.dish-description {
  max-width: 375rpx;
  margin-top: 4rpx;
  overflow: hidden;
  color: #7C7B79;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 19rpx;
  font-weight: 400;
  line-height: 26rpx;
  letter-spacing: 2rpx;
  text-overflow: ellipsis;
}

.dish-calories {
  margin-top: 4rpx;
  color: #FF6E79;
  font-family: Arial, 'PingFang SC', sans-serif;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 30rpx;
  letter-spacing: 1rpx;
}

.quantity-control {
  position: absolute;
  right: 22rpx;
  bottom: 16rpx;
  width: 162rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.90);
  border: 1rpx solid #F0E2DA;
  border-radius: 27rpx;
}

.quantity-button {
  width: 52rpx;
  min-width: 52rpx;
  height: 52rpx;
  min-height: 52rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: 0;
  border-radius: 50%;
  box-sizing: border-box;
}

.quantity-button::after {
  display: none;
}

.quantity-button[disabled] {
  opacity: 0.78;
  background: transparent;
}

.quantity-button--pressed {
  transform: scale(0.90);
}

.quantity-icon-circle {
  width: 38rpx;
  height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: #FBFCFA;
  border: 1rpx solid #E5E6E2;
  border-radius: 50%;
}

.quantity-icon-circle--add {
  background: #FFFFFF;
  border-color: #BFA99E;
}

.quantity-icon {
  width: 18rpx;
  height: 18rpx;
}

.quantity-value {
  min-width: 30rpx;
  color: #201613;
  font-family: Arial, sans-serif;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1;
  text-align: center;
}

.empty-hint {
  text-align: center;
  padding: 56rpx 40rpx;
  font-size: 24rpx;
  color: #6F7F86;
}

/* 已选菜品从结算栏上方向上展开。 */
.cart-panel-mask {
  position: fixed;
  z-index: 18;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(32, 22, 19, 0.12);
}

.selected-dishes-panel {
  position: fixed;
  z-index: 21;
  right: 36rpx;
  bottom: calc(264rpx + env(safe-area-inset-bottom));
  left: 36rpx;
  max-height: 432rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  background: rgba(255, 253, 249, 0.99);
  border: 1rpx solid rgba(113, 88, 74, 0.10);
  border-radius: 30rpx;
  box-shadow: 0 -10rpx 32rpx rgba(66, 82, 90, 0.18);
  opacity: 0;
  pointer-events: none;
  transform: translateY(28rpx);
  transition: opacity 180ms ease, transform 180ms ease;
}

.selected-dishes-panel--open {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}

.selected-panel-header {
  flex: 0 0 84rpx;
  height: 84rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  border-bottom: 1rpx solid rgba(113, 88, 74, 0.10);
}

.selected-panel-title {
  color: #201613;
  font-size: 27rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.selected-panel-count {
  color: #FF6876;
  font-family: Arial, 'PingFang SC', sans-serif;
  font-size: 21rpx;
}

.selected-dishes-list {
  flex: 1;
  min-height: 0;
}

.selected-dish-row {
  height: 116rpx;
  margin: 0 24rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  border-bottom: 1rpx solid rgba(113, 88, 74, 0.08);
}

.selected-dish-row:last-child {
  border-bottom: 0;
}

.selected-dish-image {
  flex: 0 0 82rpx;
  width: 82rpx;
  height: 82rpx;
  border-radius: 16rpx;
}

.selected-dish-copy {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.selected-dish-name,
.selected-dish-calories {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.selected-dish-name {
  color: #201613;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 32rpx;
}

.selected-dish-calories {
  margin-top: 5rpx;
  color: #7C7B79;
  font-family: Arial, 'PingFang SC', sans-serif;
  font-size: 19rpx;
  line-height: 24rpx;
}

.selected-quantity-control {
  flex: 0 0 176rpx;
  width: 176rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  background: #FFFFFF;
  border: 1rpx solid #F0E2DA;
  border-radius: 33rpx;
}

.selected-quantity-button {
  width: 64rpx;
  min-width: 64rpx;
  height: 64rpx;
  min-height: 64rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FBFCFA;
  border: 1rpx solid #E5E6E2;
  border-radius: 50%;
  box-sizing: border-box;
}

.selected-quantity-button::after {
  display: none;
}

.selected-quantity-button--add {
  background: #FFFFFF;
  border-color: #BFA99E;
}

.selected-quantity-button--pressed {
  transform: scale(0.90);
}

.selected-quantity-icon {
  width: 19rpx;
  height: 19rpx;
}

.selected-quantity-value {
  min-width: 30rpx;
  color: #201613;
  font-family: Arial, sans-serif;
  font-size: 26rpx;
  text-align: center;
}

/* 结算栏 */
.checkout-bar {
  position: fixed;
  z-index: 22;
  right: 36rpx;
  /* 底部导航占 116rpx，距屏幕底部 16rpx；这里再留出 24rpx。 */
  bottom: calc(156rpx + env(safe-area-inset-bottom));
  left: 36rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  padding: 10rpx 16rpx 10rpx 12rpx;
  box-sizing: border-box;
  color: #211713;
  background: rgba(255, 253, 249, 0.98);
  border: 1rpx solid rgba(113, 88, 74, 0.08);
  border-radius: 33rpx;
  box-shadow: 0 -5rpx 16rpx rgba(66, 105, 123, 0.08);
}

.checkout-cart-trigger {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 76rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  overflow: hidden;
  color: inherit;
  background: transparent;
  border: 0;
  border-radius: 33rpx 0 0 33rpx;
  box-sizing: border-box;
}

.checkout-cart-trigger::after {
  display: none;
}

.checkout-cart-trigger--pressed {
  background: rgba(255, 113, 128, 0.06);
}

.checkout-art-wrap {
  position: relative;
  flex: 0 0 112rpx;
  width: 112rpx;
  height: 76rpx;
}

.checkout-art {
  display: block;
  width: 112rpx;
  height: 76rpx;
}

.checkout-badge {
  position: absolute;
  top: 0;
  right: -2rpx;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 5rpx;
  box-sizing: border-box;
  color: #FFFFFF;
  background: #FF7180;
  border: 2rpx solid #FFFFFF;
  border-radius: 18rpx;
  font-family: Arial, sans-serif;
  font-size: 21rpx;
  font-weight: 500;
  line-height: 30rpx;
  text-align: center;
}

.checkout-summary {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.checkout-total {
  max-width: 100%;
  overflow: hidden;
  color: #FF6876;
  font-family: Arial, sans-serif;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.checkout-count {
  margin-top: 3rpx;
  color: #716D6A;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 18rpx;
  line-height: 22rpx;
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.checkout-chevron {
  flex: 0 0 28rpx;
  width: 28rpx;
  margin-right: 8rpx;
  color: #8B7F79;
  font-family: Arial, sans-serif;
  font-size: 26rpx;
  line-height: 28rpx;
}

.checkout-button {
  position: relative;
  flex: 0 0 220rpx;
  width: 220rpx;
  min-height: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  color: #FFFFFF;
  background: #FF7180;
  border: 1rpx solid #32211B;
  border-radius: 31rpx;
  box-sizing: border-box;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 62rpx;
  letter-spacing: 3rpx;
  text-align: center;
  box-shadow: 0 4rpx 9rpx rgba(255, 105, 119, 0.16);
}

.checkout-button::after {
  display: none;
}

.checkout-button[disabled] {
  color: rgba(255, 255, 255, 0.92);
  background: #D8CAC6;
  border-color: #BBAEA9;
}

.checkout-button--pressed {
  opacity: 0.82;
  transform: scale(0.98);
}

/* 四周留白的悬浮导航卡片。 */
.bottom-navigation {
  position: fixed;
  z-index: 19;
  right: 28rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  left: 28rpx;
  height: 116rpx;
  padding: 2rpx 8rpx;
  display: flex;
  box-sizing: border-box;
  background: rgba(255, 253, 249, 0.98);
  border: 1rpx solid rgba(117, 104, 96, 0.12);
  border-radius: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(65, 83, 91, 0.16);
}

.bottom-nav-item {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 112rpx;
  min-height: 112rpx;
  margin: 0;
  padding: 10rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  color: #716D6A;
  background: transparent;
  border: 0;
  border-radius: 0;
  box-sizing: border-box;
}

.bottom-nav-item::after {
  display: none;
}

.bottom-nav-item--pressed {
  opacity: 0.72;
  transform: scale(0.97);
}

.bottom-nav-icon-wrap {
  position: relative;
  z-index: 1;
  width: 64rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bottom-nav-icon {
  display: block;
}

.bottom-nav-label {
  position: relative;
  z-index: 1;
  height: 27rpx;
  padding: 0 2rpx 2rpx;
  box-sizing: border-box;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 24rpx;
  letter-spacing: 2rpx;
  white-space: nowrap;
}

.bottom-nav-item.active {
  color: #493B37;
}

.bottom-nav-item.active::before {
  display: none;
}

.bottom-nav-item.active .bottom-nav-label {
  font-weight: 600;
}
