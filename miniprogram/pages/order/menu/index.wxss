.menu-page { display: flex; flex-direction: column; height: 100vh; padding-bottom: calc(276rpx + env(safe-area-inset-bottom)); box-sizing: border-box; overflow: hidden; background: var(--color-bg); }
.menu-heading { flex-shrink: 0; }
.menu-columns { flex: 1; min-height: 0; display: flex; gap: 16rpx; padding: 0 24rpx 14rpx; overflow: hidden; }
.category-tabs { flex: 0 0 144rpx; width: 144rpx; height: 100%; box-sizing: border-box; border-right: 1rpx solid #E3D0B4; background: #F8EEDC; }
.category-track { padding: 6rpx 0 20rpx; }
.category-item { position: relative; display: flex; align-items: center; min-height: 88rpx; padding: 18rpx 16rpx 18rpx 22rpx; box-sizing: border-box; color: var(--color-text-secondary); font-size: 26rpx; line-height: 1.45; word-break: break-all; }
.category-item.active { color: var(--color-text); font-weight: 600; background: #FFF4D9; }
.category-item.active::before { content: ""; position: absolute; top: 22rpx; bottom: 22rpx; left: 0; width: 6rpx; border-radius: 4rpx; background: var(--color-primary); }
.category-item-pressed { opacity: .65; }
.search-row { flex-shrink: 0; display: flex; align-items: center; gap: 14rpx; margin: 14rpx 24rpx; padding: 14rpx 18rpx; border: 2rpx solid var(--color-border); border-radius: 24rpx; background: var(--color-bg-card); }
.search-row image { width: 36rpx; height: 36rpx; }
.search-input { flex: 1; height: 52rpx; font-size: 28rpx; }
.dish-list { flex: 1; width: 0; min-width: 0; height: calc(100% - 20rpx); }
.dish-section-title { display: block; margin: 8rpx 8rpx 16rpx; font-family: 'XCookHand', 'YouYuan', sans-serif; font-size: 30rpx; }
.menu-dish-card { display: flex; align-items: center; gap: 10rpx; min-height: 164rpx; padding: 10rpx 8rpx; margin: 0 4rpx 14rpx 0; box-sizing: border-box; border: 2rpx solid var(--color-text); border-radius: 28rpx 24rpx 30rpx 22rpx; background: var(--color-bg-card); box-shadow: 0 4rpx 0 #F0DFC7; }
.dish-art-box { flex-shrink: 0; width: 112rpx; height: 112rpx; border-radius: 20rpx; overflow: hidden; }
.dish-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.dish-name { font-family: 'XCookHand', 'YouYuan', sans-serif; font-size: 30rpx; line-height: 1.3; word-break: break-all; }
.dish-description { color: var(--color-text-secondary); font-size: 22rpx; line-height: 1.5; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; }
.dish-calories { font-size: 22rpx; white-space: nowrap; }
.quantity-control { position: relative; flex-shrink: 0; }
.quantity-button { display: flex; align-items: center; justify-content: center; width: 88rpx; min-height: 88rpx; margin: 0; padding: 0; background: transparent; line-height: 1; }
.quantity-circle { width: 64rpx; height: 64rpx; }
.quantity-value { position: absolute; z-index: 1; right: 0; top: -8rpx; min-width: 32rpx; padding: 3rpx 8rpx; border: 1rpx solid var(--color-text); border-radius: 20rpx; background: #FFE293; text-align: center; font-size: 22rpx; }
.wish-bar { position: fixed; z-index: 32; left: 24rpx; right: 24rpx; bottom: calc(136rpx + env(safe-area-inset-bottom)); min-height: 112rpx; display: flex; align-items: center; gap: 16rpx; padding: 8rpx 14rpx 8rpx 4rpx; border: 3rpx solid var(--color-text); border-radius: 32rpx; box-sizing: border-box; background: #FFE293; box-shadow: 0 5rpx 0 #E5CDA7; }
.wish-summary { display: flex; flex: 1; align-items: center; gap: 4rpx; margin: 0; padding: 0; text-align: left; line-height: 1.3; background: transparent; font-size: 26rpx; }
.basket { flex-shrink: 0; width: 104rpx; height: 104rpx; }
.count { font-size: 38rpx; margin: 0 6rpx; }
.summary-calories { display: block; margin-top: 6rpx; color: #916A34; font-size: 20rpx; }
.confirm-button { flex-shrink: 0; width: 270rpx; margin: 0; padding: 0 24rpx; min-height: 96rpx; font-size: 38rpx; line-height: 96rpx; }
.cart-panel-mask { position: fixed; z-index: 31; inset: 0; background: rgba(59,38,25,.3); }
.cart-panel { position: fixed; z-index: 32; left: 24rpx; right: 24rpx; bottom: calc(270rpx + env(safe-area-inset-bottom)); padding: 24rpx; border: 2rpx solid var(--color-text); border-radius: 28rpx; background: var(--color-bg-card); }
.cart-panel-heading { display: flex; justify-content: space-between; align-items: center; font-weight: 600; }
.cart-panel-list { max-height: 450rpx; }
.selected-row { display: flex; align-items: center; gap: 14rpx; padding: 16rpx 0; border-bottom: 1rpx dashed var(--color-border); }
.selected-art { flex-shrink: 0; width: 90rpx; height: 90rpx; overflow: hidden; border-radius: 16rpx; }
.selected-copy { flex: 1; min-width: 0; font-size: 26rpx; }
.selected-options { display: block; color: var(--color-text-secondary); font-size: 22rpx; line-height: 1.5; }
.selected-quantity { display: flex; align-items: center; gap: 14rpx; }
.selected-quantity button { width: 88rpx; min-height: 88rpx; margin: 0; padding: 0; line-height: 84rpx; border: 2rpx solid var(--color-text); border-radius: 50%; background: #FFE293; }
.empty-art { width: 160rpx; height: 160rpx; }
