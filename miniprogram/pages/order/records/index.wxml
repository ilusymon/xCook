<view class="wishlist-page records-page">
  <storybook-header title="我们的吃饭手账" subtitle="每一顿小幸福，都悄悄记下来。" scene="wishlist" compact bind:hometap="goHome" />
  <view class="records-body">
    <view class="record-filter" aria-role="tablist" aria-label="记录类型">
      <button class="filter-item {{currentFilter === item.value ? 'active' : ''}}" wx:for="{{filters}}" wx:key="value" bindtap="changeFilter" data-value="{{item.value}}" aria-role="tab" aria-selected="{{currentFilter === item.value}}">
        {{item.label}}
      </button>
    </view>

    <view class="state-panel" wx:if="{{error}}"><text>{{error}}</text><button class="btn-secondary" bindtap="loadRecords">重新加载</button></view>
    <view class="record-groups" wx:if="{{groups.length}}">
      <view class="record-group" wx:for="{{groups}}" wx:key="key" wx:for-item="group">
        <view class="group-heading">
          <text>{{group.title}}</text>
          <text>{{group.records.length}} 条</text>
        </view>
        <view class="record-card" wx:for="{{group.records}}" wx:key="key" wx:for-item="record">
          <view class="record-cover-wrap">
            <dish-art cover-image="{{record.coverImage}}" dish-name="{{record.title}}" />
          </view>
          <view class="record-copy">
            <view class="record-title-row">
              <text class="source-tag {{record.typeClass}}">{{record.typeLabel}}</text>
              <text class="record-title">{{record.title}}</text>
            </view>
            <text class="record-description">{{record.description}}</text>
          </view>
          <view class="record-right">
            <text class="record-status {{record.typeClass}}">{{record.statusText}}</text>
            <text class="record-time">{{record.timeText}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:elif="{{!loading && !error}}">
      <text class="empty-heart">♡</text>
      <text>还没有这类记录</text>
    </view>
    <view class="loading" wx:elif="{{loading}}">记录加载中...</view>

    <button class="add-record cartoon-button" bindtap="openForm" hover-class="cartoon-button--pressed">＋ 记录今天吃了什么</button>
  </view>

  <bottom-navigation active="record" />

  <view class="form-mask" wx:if="{{showForm}}" bindtap="closeForm">
    <view class="record-form" catchtap="stopPropagation">
      <text class="form-title">记录今天吃了什么</text>
      <text class="field-label">标题</text>
      <input class="form-input" value="{{draft.title}}" placeholder="例如：今天的早餐" maxlength="128" data-field="title" bindinput="updateDraft" />
      <text class="field-label">吃了什么</text>
      <textarea class="form-textarea" value="{{draft.description}}" placeholder="例如：煎蛋吐司、牛奶" maxlength="512" data-field="description" bindinput="updateDraft" />
      <text class="field-label">标签</text>
      <view class="food-tags">
        <button class="food-tag {{draft.tag === item ? 'active' : ''}}" wx:for="{{foodTags}}" wx:key="*this" data-tag="{{item}}" bindtap="chooseTag">{{item}}</button>
      </view>
      <view class="form-actions">
        <button class="btn-secondary" bindtap="closeForm">取消</button>
        <button class="btn-primary cartoon-button cartoon-button--compact" bindtap="saveRecord" loading="{{saving}}" disabled="{{saving}}" hover-class="cartoon-button--pressed">保存记录</button>
      </view>
    </view>
  </view>
</view>
