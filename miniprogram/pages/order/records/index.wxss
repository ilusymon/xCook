.records-page { min-height: 100vh; padding-bottom: calc(145rpx + env(safe-area-inset-bottom)); background: var(--color-bg); }
.records-body { padding: 18rpx 28rpx; }
.record-filter { display: flex; gap: 16rpx; margin-bottom: 26rpx; }
.filter-item { flex: 1; margin: 0; padding: 0 16rpx; min-height: 72rpx; border: 2rpx solid var(--color-text); border-radius: 22rpx; background: var(--color-bg-card); font-size: 26rpx; line-height: 68rpx; }
.filter-item.active { background: var(--color-primary); }
.record-group { margin-bottom: 28rpx; }
.group-heading { display: flex; justify-content: space-between; align-items: center; margin: 12rpx 4rpx; font-family: 'XCookHand', 'YouYuan', sans-serif; font-size: 30rpx; }
.group-heading text:last-child { font-family: sans-serif; font-size: 22rpx; color: var(--color-text-secondary); }
.record-card { display: flex; align-items: center; gap: 16rpx; min-height: 150rpx; margin-bottom: 16rpx; padding: 16rpx; box-sizing: border-box; background: var(--color-bg-card); border: 2rpx solid var(--color-text); border-radius: 26rpx; box-shadow: 3rpx 5rpx 0 #EEDBC0; }
.record-cover-wrap { width: 110rpx; height: 110rpx; flex-shrink: 0; overflow: hidden; border-radius: 18rpx; }
.record-copy { flex: 1; min-width: 0; }
.record-title-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8rpx; }
.source-tag { padding: 4rpx 12rpx; background: #FFE0D1; border-radius: 14rpx; font-size: 20rpx; }
.source-tag.daily { background: #DDEAC4; }
.record-title { font-family: 'XCookHand', 'YouYuan', sans-serif; font-size: 30rpx; }
.record-description { display: block; margin-top: 10rpx; color: var(--color-text-secondary); font-size: 22rpx; line-height: 1.5; word-break: break-all; }
.record-right { flex-shrink: 0; display: flex; flex-direction: column; align-items: flex-end; gap: 16rpx; font-size: 21rpx; }
.record-status { padding: 6rpx 12rpx; background: #DDEAC4; border-radius: 16rpx; }
.record-time { color: var(--color-text-secondary); }
.add-record { width: 100%; box-sizing: border-box; min-height: 88rpx; margin: 26rpx 0 12rpx; padding: 0 20rpx; border: 2rpx solid var(--color-text); border-radius: 44rpx; background: var(--color-primary); font-family: 'XCookHand', 'YouYuan', sans-serif; font-size: 32rpx; line-height: 84rpx; box-shadow: 0 4rpx 0 #E4C5A8; }
.empty-heart { font-size: 70rpx; color: var(--color-primary); }
.loading { padding: 40rpx; text-align: center; color: var(--color-text-secondary); }
.record-form { width: 100%; max-height: 85vh; overflow-y: auto; padding: 32rpx; box-sizing: border-box; background: var(--color-bg-card); border: 2rpx solid var(--color-text); border-radius: 28rpx; box-shadow: 6rpx 8rpx 0 #E7CDA6; }
.form-title {
  font-family: 'XCookHand', 'YouYuan', sans-serif; display: block; margin-bottom: 24rpx; font-family: 'XCookHand', 'YouYuan', sans-serif; font-size: 36rpx; }
.field-label { display: block; margin: 20rpx 0 10rpx; font-size: 24rpx; }
.form-input, .form-textarea { width: 100%; min-height: 88rpx; padding: 18rpx; box-sizing: border-box; border: 2rpx solid var(--color-border); border-radius: 18rpx; background: var(--color-bg); font-size: 26rpx; }
.form-textarea { height: 150rpx; }
.food-tags { display: flex; gap: 12rpx; }
.food-tag { flex: 1; min-width: 0; min-height: 72rpx; padding: 0; margin: 0; border: 2rpx solid var(--color-border); border-radius: 20rpx; background: var(--color-bg); font-size: 24rpx; line-height: 68rpx; }
.food-tag.active { background: #FFE293; border-color: var(--color-text); }
