page { height: 100vh; overflow: hidden; }

.wishlist-page { height: 100vh; display: flex; flex-direction: column; overflow: hidden; background: #DFF4FF; color: #241713; }
.custom-navigation { position: relative; flex: none; box-sizing: border-box; }
.nav-home { position: absolute; left: 36rpx; width: 58rpx; min-height: 58rpx; padding: 6rpx; background: rgba(255,255,255,.85); border: 0; border-radius: 50%; }
.nav-home::after { display: none; }
.nav-home image { width: 42rpx; height: 39rpx; }
.nav-title { position: absolute; left: 50%; display: flex; align-items: center; transform: translateX(-50%); font: 700 34rpx Georgia, serif; white-space: nowrap; }
.role-stage { position: relative; flex: 0 0 136rpx; }
.role-pill { position: absolute; top: 50rpx; height: 68rpx; display: flex; align-items: center; box-sizing: border-box; background: rgba(255,253,249,.95); border-radius: 36rpx; font-size: 24rpx; font-weight: 700; letter-spacing: 2rpx; }
.role-pill.left { left: 74rpx; width: 238rpx; padding-left: 116rpx; }
.role-pill.right { right: 74rpx; width: 252rpx; padding-left: 136rpx; }
.role-image { position: absolute; z-index: 2; bottom: 0; }
.role-image.girl { left: 45rpx; width: 144rpx; height: 134rpx; }
.role-image.boy { right: 196rpx; width: 133rpx; height: 132rpx; }
.heart { position: absolute; top: 68rpx; left: 355rpx; color: #FF7180; font-size: 34rpx; }

.wishlist-body { position: relative; flex: 1; min-height: 0; box-sizing: border-box; background: #EAF8FF; border-radius: 38rpx 38rpx 0 0; }
.gingham-grid { position: absolute; z-index: 0; top: 0; left: 0; width: 848rpx; display: flex; flex-wrap: wrap; pointer-events: none; }
.gingham-grid image { flex: 0 0 212rpx; width: 212rpx; height: 212rpx; }
.summary-card, .wish-list, .empty-state, .loading, .add-wish { position: relative; z-index: 1; }
.summary-card { margin: 28rpx 36rpx 18rpx; padding: 22rpx 26rpx; display: flex; align-items: center; justify-content: space-between; background: rgba(255,253,249,.98); border-radius: 28rpx; box-shadow: 0 4rpx 12rpx rgba(76,112,128,.08); }
.summary-title { display: block; font-size: 34rpx; font-weight: 800; }
.summary-subtitle { display: block; margin-top: 6rpx; color: #8B8581; font-size: 20rpx; }
.count-pill { min-width: 90rpx; height: 54rpx; padding: 0 18rpx; display: flex; gap: 12rpx; align-items: center; justify-content: center; box-sizing: border-box; color: #EF8297; background: #FFF4F5; border: 1rpx solid #F4CFD5; border-radius: 28rpx; font-size: 25rpx; }
.wish-list { padding: 0 36rpx; }
.wish-card { position: relative; height: 154rpx; margin-bottom: 16rpx; padding: 16rpx 20rpx; display: flex; align-items: center; box-sizing: border-box; background: rgba(255,253,249,.98); border-radius: 30rpx; box-shadow: 0 4rpx 12rpx rgba(76,112,128,.08); }
.dish-cover-wrap { width: 136rpx; height: 118rpx; display: flex; align-items: center; justify-content: center; overflow: hidden; background: #FFF4D8; border-radius: 20rpx; }
.dish-cover { width: 122rpx; height: 102rpx; }
.card-heart { position: absolute; top: 10rpx; left: 149rpx; color: #EE7E91; font-size: 32rpx; }
.wish-copy { flex: 1; min-width: 0; margin-left: 28rpx; }
.dish-name { display: block; max-width: 320rpx; overflow: hidden; font-size: 27rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.dish-status { display: block; margin-top: 10rpx; color: #E9A243; font-size: 21rpx; font-weight: 600; }
.dish-status.accepted, .dish-status.cooking { color: #EF667E; }
.dish-status.done { color: #51BF62; }
.dish-status.cancelled { color: #99908B; }
.dish-remaining { display: block; margin-top: 4rpx; color: #99908B; font-size: 19rpx; }
.wish-action { width: 142rpx; min-height: 88rpx; padding: 0; color: #6D4616; background: #F2BD5F; border: 1rpx solid #71552D; border-radius: 44rpx; font-size: 21rpx; line-height: 86rpx; }
.wish-action::after { display: none; }
.wish-action.cooking, .wish-action.accepted { color: #fff; background: #FF7180; border-color: #50302C; }
.wish-action.done, .wish-action[disabled] { color: #fff; background: #5CCB67; border-color: #398F45; opacity: 1; }
.wish-action.cancelled, .wish-action.cancelled[disabled] { color: #7C7774; background: #E8E5E3; border-color: #B8B1AD; }
.empty-state, .loading { padding: 120rpx 40rpx 40rpx; color: #7C8588; text-align: center; }
.empty-heart { display: block; margin-bottom: 10rpx; color: #EF8297; font-size: 80rpx; }
.add-wish { width: 390rpx; min-height: 64rpx; margin: 28rpx auto 164rpx; color: #EF667E; background: rgba(255,253,249,.96); border: 1rpx solid #EFA2AF; border-radius: 34rpx; font-size: 24rpx; line-height: 62rpx; }
.add-wish::after { display: none; }
.bottom-navigation { position: fixed; z-index: 20; right: 28rpx; bottom: calc(16rpx + env(safe-area-inset-bottom)); left: 28rpx; height: 116rpx; padding: 2rpx 8rpx; display: flex; box-sizing: border-box; background: rgba(255,253,249,.98); border: 1rpx solid rgba(117,104,96,.12); border-radius: 28rpx; box-shadow: 0 10rpx 30rpx rgba(65,83,91,.16); }
.bottom-nav-item { position: relative; flex: 1; min-width: 0; min-height: 112rpx; margin: 0; padding: 10rpx 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2rpx; color: #716D6A; background: transparent; border: 0; border-radius: 0; box-sizing: border-box; font-size: 19rpx; }
.bottom-nav-item::after { display: none; }
.bottom-nav-item > image, .bottom-nav-item > text { position: relative; z-index: 1; }
.bottom-nav-item--pressed { opacity: .72; transform: scale(.97); }
.bottom-nav-item.active { color: #493B37; }
.bottom-nav-item.active::before { display: none; }
.bottom-nav-item.active > text { font-weight: 600; white-space: nowrap; }
