.wishlist-page { min-height: 100vh; padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); background: var(--color-bg); }
.list-caption { display: flex; justify-content: space-between; align-items: center; margin: 0 32rpx 18rpx; color: var(--color-text-secondary); font-size: 22rpx; }
.wish-entry { margin: 28rpx 30rpx 38rpx; }
.wish-paper { position: relative; padding: 30rpx 32rpx 32rpx; }
.paper-skin { position: absolute; top: 0; right: 0; bottom: 0; left: 0; pointer-events: none; }
.paper-skin image { position: absolute; left: 0; width: 100%; }
.paper-top { top: 0; height: 64rpx; }
.paper-middle { top: 62rpx; height: calc(100% - 108rpx); }
.paper-bottom { bottom: 0; height: 48rpx; }
.paper-content { position: relative; z-index: 1; }
.paper-clip { position: absolute; z-index: 3; width: 48rpx; height: 86rpx; top: -20rpx; left: 48rpx; transform: rotate(-5deg); pointer-events: none; }
.paper-leaf { position: absolute; z-index: 2; width: 36rpx; height: 58rpx; pointer-events: none; }
.paper-leaf-left { left: 14rpx; top: 88rpx; transform: rotate(-14deg); }
.paper-leaf-right { right: 16rpx; top: 20rpx; transform: rotate(8deg); }
.paper-title { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12rpx; padding-left: 52rpx; padding-right: 8rpx; font-family: 'XCookHand', 'YouYuan', sans-serif; font-size: 42rpx; line-height: 1.3; }
.heart { color: #FF8D73; font-size: 32rpx; }
.wish-status { flex-shrink: 0; padding: 7rpx 18rpx; border: 1rpx solid #E9BB69; border-radius: 18rpx 22rpx 20rpx 16rpx; background: linear-gradient(180deg, #FFE5A5, #FFDC88); font-family: sans-serif; font-size: 22rpx; line-height: 1.4; }
.wish-status.accepted, .wish-status.done { color: #536D35; border-color: #A3C46A; background: linear-gradient(180deg, #E0EEC8, #BDDB91); }
.wish-status.cooking { color: #42677B; border-color: #9BC2D3; background: linear-gradient(180deg, #E2EFF6, #BCDDEB); }
.wish-status.cancelled { color: #8A7466; border-color: #D5C3AF; background: #EEE2D5; }
.paper-dishes { margin-top: 20rpx; }
.paper-dish { display: flex; align-items: center; gap: 14rpx; padding: 6rpx 0; }
.paper-art { flex-shrink: 0; width: 120rpx; height: 104rpx; overflow: hidden; border-radius: 16rpx; }
.paper-dish-copy { flex: 1; min-width: 0; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.paper-dish-title { flex: 1; min-width: 0; display: flex; align-items: center; gap: 10rpx; }
.paper-dish-name { font-family: 'XCookHand', 'YouYuan', sans-serif; font-size: 32rpx; line-height: 1.4; }
.paper-quantity { flex-shrink: 0; white-space: nowrap; font-size: 26rpx; }
.dish-options { flex-shrink: 0; max-width: 180rpx; display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8rpx; }
.dish-options text { max-width: 100%; padding: 5rpx 14rpx; box-sizing: border-box; border-radius: 16rpx 12rpx 18rpx 14rpx; background: #FFDCC4; color: #894C35; font-size: 20rpx; line-height: 1.4; word-break: break-all; }
.paper-total { display: block; margin: 14rpx 18rpx 0; padding-top: 18rpx; border-top: 2rpx dashed #BFA284; text-align: center; font-size: 28rpx; line-height: 1.4; }
.wish-note { position: relative; margin-top: 24rpx; padding: 16rpx 38rpx 18rpx 74rpx; border-radius: 24rpx 20rpx 28rpx 18rpx; background: linear-gradient(110deg, #FFDDCC, #FFD8C7 65%, #FFE0D3); }
.note-pencil { position: absolute; top: -12rpx; left: -6rpx; width: 74rpx; height: 90rpx; }
.note-title { display: block; margin-bottom: 8rpx; font-family: 'XCookHand', 'YouYuan', sans-serif; font-size: 30rpx; line-height: 1.4; }
.note-copy { display: block; font-size: 26rpx; line-height: 1.65; word-break: break-all; }
.note-heart { position: absolute; bottom: 12rpx; right: 16rpx; color: #F67F64; font-size: 26rpx; }
.heart-progress { position: relative; display: flex; margin: 16rpx 12rpx 18rpx; }
.heart-progress::before { content: ''; position: absolute; top: 24rpx; left: 12%; right: 12%; border-top: 2rpx dashed #B89A80; }
.progress-stop { position: relative; flex: 1; display: flex; flex-direction: column; align-items: center; gap: 6rpx; font-size: 26rpx; }
.progress-heart { width: 46rpx; height: 46rpx; padding: 0 8rpx; background: var(--color-bg); }
.wish-action { min-height: 104rpx; margin: 20rpx 24rpx 0; padding: 0 28rpx; font-size: 40rpx; line-height: 104rpx; }
.wish-meta { display: block; margin-top: 18rpx; text-align: center; color: var(--color-text-secondary); font-size: 20rpx; }
.empty-art { width: 180rpx; height: 180rpx; }
