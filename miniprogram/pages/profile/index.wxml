<view class="profile-page">
  <storybook-header title="我的小厨房" subtitle="好好吃饭，也好好收藏生活。" scene="chef" compact show-search bind:hometap="goHome" bind:searchtap="goSearch" />
  <view class="profile-content">
    <view class="state-panel" wx:if="{{error}}"><text>{{error}}</text><button class="btn-secondary" bindtap="loadProfile">重新加载</button></view>
    <view class="state-panel" wx:elif="{{loading}}">厨房信息加载中…</view>
    <button class="person-card" bindtap="showProfileInfo" aria-label="编辑昵称">
      <image class="avatar" src="{{user.avatarUrl}}" mode="aspectFill" />
      <view class="person-copy"><text class="person-name">{{user.nickName}}</text><text class="role-pill">{{user.roleLabel}} · 厨房伙伴</text></view><text class="edit-copy">编辑 ›</text>
    </button>
    <view class="kitchen-card"><view class="kitchen-art"><kitchen-art kind="wishes" /></view><view><text class="kitchen-title">我们的厨房</text><text class="together-copy">共享厨房 · 加入 {{togetherDays}} 天</text></view><text class="kitchen-heart">♥</text></view>
    <view class="stats-card">
      <view class="stat-item"><text class="stat-value">{{orderCount}}</text><text class="stat-label">份愿望</text></view>
      <view class="stat-item"><text class="stat-value">{{dishCount}}</text><text class="stat-label">道菜</text></view>
      <view class="stat-item"><text class="stat-value">{{recordDays}}</text><text class="stat-label">天记录</text></view>
    </view>
    <view class="settings-card">
      <button class="setting-row" bindtap="goDishManage"><view class="setting-art"><kitchen-art kind="dishes" /></view><text class="setting-label">菜品管理</text><text class="setting-value">{{dishCount}} 道菜</text><text>›</text></button>
      <button class="setting-row" bindtap="goCategoryManage"><view class="setting-art"><kitchen-art kind="categories" /></view><text class="setting-label">分类管理</text><text class="setting-value">整理菜单</text><text>›</text></button>
      <button class="setting-row" bindtap="goChef"><view class="setting-art"><kitchen-art kind="add" /></view><text class="setting-label">进入厨房</text><text class="setting-value">我是大厨</text><text>›</text></button>
      <button class="setting-row" open-type="feedback"><image class="feedback-icon" src="/images/cartoon/wishlist.svg" mode="aspectFit" /><text class="setting-label">意见反馈</text><text>›</text></button>
    </view>
  </view>
  <bottom-navigation active="profile" />
  <view class="form-mask" wx:if="{{showForm}}" bindtap="closeForm">
    <view class="profile-form" catchtap="stopPropagation"><text class="section-title">编辑昵称</text><input class="input-box" value="{{nickName}}" bindinput="onNameInput" placeholder="给自己取个昵称" maxlength="32" /><view class="form-actions"><button class="btn-secondary" bindtap="closeForm" disabled="{{saving}}">取消</button><button class="btn-primary cartoon-button cartoon-button--compact" bindtap="saveProfile" loading="{{saving}}" disabled="{{saving}}" hover-class="cartoon-button--pressed">保存</button></view></view>
  </view>
</view>
