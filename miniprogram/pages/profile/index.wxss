page {
  height: 100vh;
  overflow: hidden;
}

.profile-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  color: #241713;
  background: #DFF4FF;
}

.custom-navigation {
  position: relative;
  flex: none;
  box-sizing: border-box;
}

.navigation-title {
  position: absolute;
  left: 50%;
  display: flex;
  align-items: center;
  transform: translateX(-50%);
  font: 700 34rpx Georgia, serif;
  white-space: nowrap;
}

.navigation-button {
  position: absolute;
  width: 88rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.navigation-tap,
.person-card-tap,
.setting-row-tap {
  margin: 0;
  background: transparent;
  border: 0;
  box-sizing: border-box;
}

.navigation-tap {
  width: 100%;
  height: 100%;
  min-height: 88rpx;
  padding: 12rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.navigation-tap::after,
.person-card-tap::after,
.setting-row-tap::after,
.bottom-nav-item::after {
  display: none;
}

.navigation-tap image {
  width: 48rpx;
  height: 48rpx;
}

.home-button {
  left: 16rpx;
}

.profile-body {
  position: relative;
  flex: 1;
  min-height: 0;
  background: #EAF8FF;
  border-radius: 38rpx 38rpx 0 0;
}

.gingham-grid {
  position: absolute;
  z-index: 0;
  top: 0;
  left: 0;
  width: 848rpx;
  display: flex;
  flex-wrap: wrap;
  pointer-events: none;
}

.gingham-grid image {
  flex: 0 0 212rpx;
  width: 212rpx;
  height: 212rpx;
}

.profile-content {
  position: relative;
  z-index: 1;
  padding: 24rpx 36rpx calc(164rpx + env(safe-area-inset-bottom));
}

.person-card,
.kitchen-card,
.stats-card,
.settings-card {
  width: 100%;
  margin: 0 0 18rpx;
  background: rgba(255, 253, 249, 0.98);
  border: 1rpx solid rgba(226, 208, 198, 0.58);
  border-radius: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(76, 112, 128, 0.08);
  box-sizing: border-box;
}

.person-card {
  position: relative;
  min-height: 156rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  color: #241713;
  line-height: 1.25;
  text-align: left;
}

.person-card-tap {
  position: absolute;
  z-index: 2;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: auto;
  height: auto;
  padding: 0;
  border-radius: 28rpx;
}

.person-card-tap-active {
  background: rgba(36, 23, 19, 0.06);
}

.avatar {
  flex: none;
  width: 104rpx;
  height: 104rpx;
  overflow: hidden;
  background: #FFF1E3;
  border: 4rpx solid #FFFFFF;
  border-radius: 30rpx;
  box-shadow: 0 3rpx 10rpx rgba(91, 60, 49, 0.12);
}

.person-copy {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.person-name {
  display: block;
  max-width: 270rpx;
  overflow: hidden;
  font-size: 32rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.person-meta {
  margin-top: 13rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.role-pill {
  padding: 6rpx 14rpx;
  color: #E75F78;
  background: #FFF0F3;
  border-radius: 18rpx;
  font-size: 19rpx;
  font-weight: 600;
}

.identity-copy,
.edit-copy {
  color: #9A918C;
  font-size: 19rpx;
}

.edit-copy {
  position: absolute;
  right: 25rpx;
  bottom: 22rpx;
}

.kitchen-card {
  min-height: 174rpx;
  padding: 22rpx 26rpx;
}

.card-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 27rpx;
  font-weight: 800;
}

.relation-status {
  padding: 6rpx 14rpx;
  color: #39A86D;
  background: #EAF9F1;
  border-radius: 18rpx;
  font-size: 18rpx;
}

.kitchen-body {
  height: 87rpx;
  padding: 0 54rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.partner-avatar {
  width: 92rpx;
  height: 86rpx;
}

.heart-badge {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #F06F85;
  background: #FFF0F3;
  border-radius: 50%;
  font-size: 27rpx;
}

.together-copy {
  display: block;
  color: #8B8581;
  font-size: 20rpx;
  text-align: center;
}

.stats-card {
  min-height: 112rpx;
  display: flex;
  align-items: center;
}

.stat-item {
  position: relative;
  flex: 1;
  text-align: center;
}

.stat-item + .stat-item::before {
  position: absolute;
  top: 7rpx;
  bottom: 7rpx;
  left: 0;
  width: 1rpx;
  background: #F0E2DA;
  content: '';
}

.stat-value,
.stat-label {
  display: block;
}

.stat-value {
  color: #EF7188;
  font-size: 31rpx;
  font-weight: 800;
}

.stat-label {
  margin-top: 8rpx;
  color: #8B8581;
  font-size: 19rpx;
}

.settings-card {
  overflow: hidden;
}

.setting-row {
  position: relative;
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  color: #241713;
  line-height: 1;
  text-align: left;
  background: transparent;
  border: 0;
  border-radius: 0;
  box-sizing: border-box;
}

.setting-row + .setting-row::before {
  position: absolute;
  top: 0;
  right: 22rpx;
  left: 78rpx;
  height: 1rpx;
  background: #F1E5DE;
  content: '';
}

.setting-row-tap {
  position: absolute;
  z-index: 2;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: auto;
  height: auto;
  padding: 0;
  border-radius: 0;
}

.setting-row-tap-active {
  background: rgba(36, 23, 19, 0.06);
}

.setting-icon {
  flex: none;
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 13rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.setting-icon.pink { color: #E7657D; background: #FFF0F3; }
.setting-icon.yellow { color: #C99735; background: #FFF7DF; }
.setting-icon.green { color: #38A86C; background: #EAF9F1; }
.setting-icon.blue { color: #438EB1; background: #EAF7FD; }

.setting-label {
  flex: 1;
  margin-left: 18rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.setting-value {
  color: #9A918C;
  font-size: 19rpx;
}

.setting-arrow {
  margin-left: 13rpx;
  color: #AFA7A2;
  font-size: 30rpx;
}

.bottom-navigation {
  position: fixed;
  z-index: 20;
  right: 28rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  left: 28rpx;
  height: 116rpx;
  padding: 2rpx 8rpx;
  display: flex;
  box-sizing: border-box;
  background: rgba(255, 253, 249, 0.98);
  border: 1rpx solid rgba(117, 104, 96, 0.12);
  border-radius: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(65, 83, 91, 0.16);
}

.bottom-nav-item {
  position: relative;
  flex: 1;
  min-width: 0;
  min-height: 112rpx;
  margin: 0;
  padding: 10rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  color: #716D6A;
  background: transparent;
  border: 0;
  border-radius: 0;
  box-sizing: border-box;
  font-size: 19rpx;
}

.bottom-nav-item > image,
.bottom-nav-item > text {
  position: relative;
  z-index: 1;
}

.bottom-nav-item--pressed {
  opacity: 0.72;
  transform: scale(0.97);
}

.bottom-nav-item.active {
  color: #493B37;
}

.bottom-nav-item.active::before {
  display: none;
}

.bottom-nav-item.active > text {
  font-weight: 600;
  white-space: nowrap;
}
