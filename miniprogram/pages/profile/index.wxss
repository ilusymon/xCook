.profile-page { min-height: 100vh; padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); background: var(--color-bg); }
.profile-content { padding: 20rpx 28rpx; }
.person-card { width: 100%; box-sizing: border-box; display: flex; align-items: center; gap: 24rpx; margin: 0 0 24rpx; padding: 24rpx; border: 2rpx solid var(--color-text); border-radius: 26rpx; background: var(--color-bg-card); text-align: left; line-height: 1.5; box-shadow: 3rpx 5rpx 0 #EEDBC0; }
.avatar { width: 112rpx; height: 112rpx; flex-shrink: 0; border: 2rpx solid var(--color-text); border-radius: 50%; background: #FFE293; }
.person-copy { flex: 1; min-width: 0; }
.person-name { display: block; font-family: 'XCookHand', 'YouYuan', sans-serif; font-size: 38rpx; word-break: break-all; }
.role-pill { display: block; margin-top: 10rpx; color: var(--color-text-secondary); font-size: 22rpx; }
.edit-copy { white-space: nowrap; flex-shrink: 0; font-size: 24rpx; color: var(--color-primary-dark); }
.kitchen-card { display: flex; align-items: center; gap: 18rpx; padding: 12rpx 26rpx 12rpx 8rpx; border: 2rpx solid var(--color-text); border-radius: 26rpx; background: #FFE9B2; }
.kitchen-art { width: 120rpx; height: 120rpx; flex-shrink: 0; }
.kitchen-title { font-family: 'XCookHand', 'YouYuan', sans-serif; font-size: 36rpx; }
.together-copy { display: block; margin-top: 8rpx; font-size: 23rpx; }
.kitchen-heart { margin-left: auto; color: var(--color-primary); font-size: 44rpx; }
.stats-card { display: flex; margin: 24rpx 0; padding: 24rpx 0; border: 2rpx dashed var(--color-border); border-radius: 24rpx; background: var(--color-bg-card); }
.stat-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; border-right: 1rpx solid #E7D4BD; }
.stat-item:last-child { border: 0; }
.stat-value { font-size: 40rpx; color: var(--color-primary-dark); }
.stat-label { font-size: 24rpx; color: var(--color-text-secondary); }
.settings-card { border: 2rpx solid var(--color-text); border-radius: 26rpx; background: var(--color-bg-card); overflow: hidden; box-shadow: 3rpx 5rpx 0 #EEDBC0; }
.setting-row { width: 100%; box-sizing: border-box; display: flex; align-items: center; gap: 14rpx; min-height: 108rpx; margin: 0; padding: 10rpx 22rpx; background: transparent; border-bottom: 1rpx dashed var(--color-border); text-align: left; font-size: 28rpx; line-height: 1.5; }
.setting-row:last-child { border: 0; }
.setting-art { width: 86rpx; height: 86rpx; flex-shrink: 0; }
.feedback-icon { flex-shrink: 0; width: 50rpx; height: 50rpx; margin: 18rpx; }
.setting-label { flex: 1; min-width: 0; text-align: left; white-space: nowrap; }
.setting-value { flex-shrink: 0; white-space: nowrap; color: var(--color-text-secondary); font-size: 22rpx; }
.profile-form { width: 100%; max-width: 650rpx; padding: 32rpx; box-sizing: border-box; background: var(--color-bg-card); border: 2rpx solid var(--color-text); border-radius: 28rpx; box-shadow: 6rpx 8rpx 0 #E7CDA6; }
