/* Layout comes from the kitchen theme, not WeChat's centered button preset. */
button {
  display: block;
  width: auto;
  min-width: 0;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border: 0;
  background: transparent;
  color: inherit;
  font-family: inherit;
  font-size: inherit;
  font-weight: inherit;
  line-height: inherit;
}
button::after { border: 0; }
