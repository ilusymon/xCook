/* Use the same illustrated skin on real buttons; page files retain layout and dimensions. */
button.cartoon-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 0;
  border-radius: 0;
  color: #FFFDF5;
  background-color: transparent;
  background-image: url('data:image/svg+xml;base64,');
  background-size: 100% 100%;
  background-repeat: no-repeat;
  box-shadow: none;
  font-family: 'XCookHand', 'YouYuan', sans-serif;
  font-weight: 700;
  letter-spacing: 1rpx;
}
button.cartoon-button--compact { background-image: url('data:image/svg+xml;base64,'); }
button.cartoon-button::after { border: 0; }
button.cartoon-button--pressed { transform: translateY(2rpx); opacity: .92; }
button.cartoon-button[disabled] { opacity: .5; }
